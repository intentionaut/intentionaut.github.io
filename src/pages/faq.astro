---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faqs';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title="FAQ | Saielle DaSilva"
  description="Practical answers about working with Saielle DaSilva: sliding scale, engagements, sessions, speaking logistics and payment."
  jsonLd={faqSchema}
>

  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">FAQ</p>
      <h1>Fair questions.</h1>
      <p class="lede">
        Straight answers about rates, sliding scale and how engagements
        actually run. Anything missing: ask me.
      </p>
    </header>

    <div class="faq faq-page">
      {
        faqs.map((f) => (
          <section>
            <h2>{f.question}</h2>
            {f.answer.split(/\n\s*\n/).map((para) => (
              <p>{para.trim()}</p>
            ))}
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* The question list from the design system, every answer open: an ink rule
     above the list, a slate rule under each question, questions at
     --text-md. It starts on the page intro's gap and ends on the section gap. */
  .faq-page {
    border-top: 1px solid var(--ink);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .faq-page section {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--slate);
  }
  .faq-page h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-md);
    font-weight: 500;
    line-height: 1.25;
  }
  .faq-page p:last-child {
    margin-bottom: 0;
  }
</style>
