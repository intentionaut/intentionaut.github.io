---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faqs';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title="FAQ | Saielle DaSilva"
  description="Practical answers about working with Saielle DaSilva: sliding scale, engagements, sessions, speaking logistics and payment."
  jsonLd={faqSchema}
>

  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">FAQ</p>
      <h1>Fair questions.</h1>
      <p class="lede">
        Straight answers about rates, sliding scale and how engagements
        actually run. Anything missing: ask me.
      </p>
    </header>

    <div class="faq">
      {
        faqs.map((f) => (
          <section>
            <h2>{f.question}</h2>
            <p>{f.answer}</p>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
