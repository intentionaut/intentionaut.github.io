---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FrameSubscribe from '../components/FrameSubscribe.astro';
import { testimonialsFor } from '../data/testimonials';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { BOOKING_URL } from '../data/links';
import { rates, gbp } from '../data/rates';
import { results } from '../data/results';
import Plate from '../components/Plate.astro';
import FaqList from '../components/FaqList.astro';
import { faqsFor } from '../data/faqs';

// The story, top to bottom: who she is and who brings her in, proof, the
// offers, the case studies, what people said, what she has built, then ways
// to follow along.
// Every figure below is already published on /for-advisors/ and /fractional/.

const offers = [
  {
    title: 'Workshops',
    icon: 'strategy' as const,
    who: 'For CPOs, CTOs, CDOs and their teams who need one decision made and owned. AI product strategy, opportunity mapping and product maturity.',
    shape: `Two hours to a full day, from ${gbp(rates.workshopTaster)}.`,
    href: '/workshops/',
  },
  {
    title: 'AI product audit',
    icon: 'magnifying-glass' as const,
    who: 'For leadership teams with AI work underway and no shared view of which of it matters.',
    shape: `Two days across one week, ${gbp(rates.aiAudit)} fixed.`,
    href: '/ai-product-audit/',
  },
  {
    title: 'Product strategy sprint',
    icon: 'compass' as const,
    who: 'For teams with an opportunity and no shared view of what to build.',
    shape: `Four days across two weeks, ${gbp(rates.strategySprint)} fixed.`,
    href: '/product-strategy-sprint/',
  },
  {
    title: 'Fractional leadership',
    icon: 'lighthouse' as const,
    who: 'For teams building AI products who need Director-level product and design leadership.',
    shape: 'One or two days a week, one month minimum, then 30 days\' notice.',
    href: '/fractional/',
  },
  {
    title: 'Product building',
    icon: 'hammer' as const,
    who: 'For teams with a real problem, a rough idea of the answer, and nobody free to build it.',
    shape: 'Three days a week in your environment, four to twelve weeks.',
    href: '/forward-deployed/',
  },
];

const built = (await getCollection('projects'))
  .filter((p) => ['friday-for-work', 'kernic', 'familiar'].includes(p.id))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const studyOrder = ['cazoo', 'cazoo-purchase', 'stepstone'];
const studies = (await getCollection('caseStudies'))
  .filter((s) => studyOrder.includes(s.id))
  .sort((a, b) => studyOrder.indexOf(a.id) - studyOrder.indexOf(b.id));
if (studies.length !== studyOrder.length) throw new Error('A homepage case study is missing');

const homeTestimonials = testimonialsFor('home');
const homeFaqs = faqsFor('home');
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer.replace(/\s+/g, ' ').trim() },
  })),
};
---

<BaseLayout
  title="Fractional & Interim CPO | Saielle DaSilva"
  description="Fractional CPO for AI products. Saielle DaSilva leads product, data and design for teams building with AI. London, working across the UK and Europe."
  jsonLd={faqSchema}
>
  <section class="wrap hero">
    <p class="eyebrow">Saielle DaSilva · Fractional CPO for AI products</p>
    <h1 id="hero-h1">I speak <em>four</em> languages: design, product, data&nbsp;&amp;&nbsp;AI.</h1>
    {/* Headline A/B test (PostHog flag "hero-headline"). Crawlers and anyone
        who declines cookies always get the headline above; only readers who
        accepted can be shown the variant. */}
    <script is:inline>
      document.addEventListener('posthog:ready', function () {
        window.posthog.onFeatureFlags(function () {
          if (window.posthog.getFeatureFlag('hero-headline') === 'building') {
            var h = document.getElementById('hero-h1');
            if (h) h.textContent = 'The product leader for teams building with AI.';
          }
        });
      });
    </script>
    <p class="lede">
      Saielle DaSilva is a fractional Chief Product Officer for teams
      working across AI, data and design. She led product and design at
      StepStone, ran product for AI, data platforms and machine learning
      at Sainsbury's, and was the first design hire at Cazoo. Founders bring her
      in when product leadership is missing, an AI pilot won't reach
      production, or the strategy isn't turning into business impact.
    </p>
    <div class="cta-row">
      <a class="btn-primary" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a free call</a>
      <a class="link-arrow" href="/about/">My story</a>
    </div>
  </section>

  <section class="wrap home-section" aria-labelledby="proof-h">
    <h2 id="proof-h" class="eyebrow">Track record</h2>
    <ul class="stat-strip home-stats">
      {results.map((r) => (
        <li>
          <span class="stat-num">{r.num}</span>
          <span class="stat-label">{r.label}</span>
        </li>
      ))}
    </ul>
    <p class="home-also">Before that: Pivotal, Amazon, AT&amp;T, Google and VMware.</p>
  </section>

  <section class="wrap home-section" aria-labelledby="offers-h">
    <h2 id="offers-h" class="home-h2">Five ways to work together.</h2>
    <div class="rates rates-pair home-offers">
      {offers.map((o, i) => (
        <a class="rate-row rate-card plated" href={o.href}>
          <Plate name={o.icon} tone={i % 2 ? 'blue' : 'pink'} />
          <p class="rate-name">{o.title}</p>
          <p class="rate-desc">{o.who}</p>
          <p class="rate-shape">{o.shape}</p>
        </a>
      ))}
    </div>
    <p class="home-note">
      Not sure which? <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a free call</a>
      {' '}and we'll work it out, or compare them on the <a href="/contact/">contact page</a>.
    </p>
  </section>

  <section class="wrap home-section" aria-labelledby="studies-h">
    <h2 id="studies-h" class="home-h2">The work behind the numbers.</h2>
    <ol class="project-list">
      {studies.map((s) => (
        <li class="project-row">
          <a class="project-card" href={`/case-studies/${s.id}/`}>
            <span class="talk-title">{s.data.title}</span>
            <span class="project-summary">{s.data.summary}</span>
          </a>
        </li>
      ))}
    </ol>
    <a class="link-arrow" href="/case-studies/"><span>All case studies</span></a>
  </section>

  <div class="wrap home-section">
    <TestimonialCarousel testimonials={homeTestimonials} heading="What people say" />
  </div>

  <section class="wrap home-section" aria-labelledby="built-h">
    <h2 id="built-h" class="home-h2">What I've built lately.</h2>
    <ol class="project-list">
      {built.map((p) => (
        <li class="project-row">
          <a class="project-card" href={`/projects/${p.id}/`}>
            <span class="talk-title">{p.data.title}</span>
            <span class="project-summary">{p.data.summary}</span>
          </a>
        </li>
      ))}
    </ol>
    <a class="link-arrow" href="/projects/"><span>All projects</span></a>
  </section>


  <section class="wrap lanes home-follow" aria-label="Follow the thinking">
    <ol>
      <li class="lane">
        <h2>Speaking</h2>
        <p>
          Talks and workshops on building intentional products in the age of
          AI: honest, practical, hype-free.
        </p>
        <a class="link-arrow" href="/speaking/"><span>See talks</span></a>
      </li>
      <li class="lane">
        <h2>Writing</h2>
        <p>
          Notes on craft, leadership and learning in public. New essays land
          in Intentionaut first.
        </p>
        <a class="link-arrow" href="/writing/"><span>Read along</span></a>
      </li>
    </ol>
  </section>

  <section class="wrap home-section">
    <FaqList heading="How to get value from AI" items={homeFaqs} />
    <p class="home-note">
      Figures from Gartner and DSIT, with their sources, on
      {' '}<a href="/ai-adoption-evidence/">what the data says about AI in business</a>.
    </p>
  </section>

  <section class="wrap signup" aria-label="Newsletter signup">
    <FrameSubscribe
      eyebrow="Newsletter"
      heading="How leaders set direction when AI does more of the building. Field-tested with the receipts."
      source="home"
      emailId="home-email"
      buttonLabel="Subscribe"
      align="left"
    />
  </section>
</BaseLayout>

<style>
  /* The design system's one section gap (Layout). */
  .home-section {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .home-h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-6);
  }
  .home-stats {
    margin-top: 0;
  }
  /* The shared list carries its own section gap; here the section does. */
  .home-section .project-list {
    padding-bottom: 0;
    margin-bottom: var(--space-6);
  }
  .home-also,
  .home-note {
    margin: var(--space-6) 0 0;
    font-size: 0.95rem;
    color: var(--muted);
  }


  /* Plated offer cards: centred, like a label, with signage-style titles. */
  .plated {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }
  .plated .rate-name {
    margin-top: var(--space-2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.95rem;
  }
  .plated .rate-shape {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--slate);
    align-self: stretch;
  }

  @media (min-width: 1000px) {
    .home-offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .home-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
