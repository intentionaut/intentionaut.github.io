---
import BaseLayout from '../layouts/BaseLayout.astro';
import FrameSubscribe from '../components/FrameSubscribe.astro';
---

<BaseLayout
  title="Saielle DaSilva | Fractional & Interim Product Leadership"
  description="Fractional and interim product leadership for teams working across AI, data and design. Founders and product leaders bring Saielle DaSilva in when direction is the bottleneck."
>
  <section class="wrap hero">
    <p class="eyebrow">Saielle DaSilva · Product Leader</p>
    <h1>I speak <em>four</em> languages: design, product, data &amp; AI.</h1>
    <p class="lede">
      Hi, I'm Saielle. Founders and product leaders bring me in when
      direction is the bottleneck. I turn design, data and AI into
      deliberate choices, aligned teams and shipped results.
    </p>
    <div class="cta-row">
      <a class="btn-primary" href="/contact/">Work with me</a>
      <a class="link-arrow" href="/about/">My story</a>
    </div>
  </section>

  <section class="wrap cred-strip" aria-label="Teams and clients">
    <p class="cred-label">Teams &amp; clients</p>
    <ul class="cred-logos">
      <li>StepStone</li>
      <li>Sainsbury's</li>
      <li>Cazoo</li>
      <li>Pivotal</li>
      <li>Amazon</li>
      <li>AT&amp;T</li>
      <li>Google</li>
      <li>VMware</li>
    </ul>
  </section>

  <section class="wrap manifesto">
    <p>
      In most teams, productivity issues aren't down to talent or tools,
      they're due to a lack of intention. I help teams set clear intentions
      and get the results they're looking for.
    </p>
  </section>

  <section class="wrap lanes" aria-label="What I do">
    <ol>
      <li class="lane">
        <span class="num" aria-hidden="true">01</span>
        <h3>Leadership &amp; advisory</h3>
        <p>
          Fractional product leadership and strategic advisory for teams
          working across design, data and AI at once.
        </p>
        <a class="link-arrow" href="/contact/"><span>Work with me</span></a>
      </li>
      <li class="lane">
        <span class="num" aria-hidden="true">02</span>
        <h3>Speaking</h3>
        <p>
          Talks and workshops on building intentional products in the age of
          AI: honest, practical, hype-free.
        </p>
        <a class="link-arrow" href="/speaking/"><span>See talks</span></a>
      </li>
      <li class="lane">
        <span class="num" aria-hidden="true">03</span>
        <h3>Writing</h3>
        <p>
          Notes on craft, leadership and learning in public. New essays land
          in Intentionaut first.
        </p>
        <a class="link-arrow" href="/writing/"><span>Read along</span></a>
      </li>
    </ol>
  </section>

  <section class="wrap signup" aria-label="Newsletter signup">
    <FrameSubscribe
      eyebrow="Newsletter"
      heading="Intentionaut is a fortnightly letter on design, product, data and AI. What is working, what isn't, and how to keep your bearings."
      source="home"
      emailId="home-email"
      buttonLabel="Subscribe"
    />
  </section>
</BaseLayout>
