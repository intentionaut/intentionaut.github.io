---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { BOOKING_URL } from '../data/links';
import { rates, fractionalMonthly1Day, fractionalMonthly2Day } from '../data/rates';

// Same offer and terms as /fractional/; this page is the interim name for it.
const serviceSchema = {
  '@type': 'Service',
  '@id': 'https://intentionaut.com/interim-cpo/#service',
  name: 'Interim CPO',
  serviceType: 'Interim product leadership',
  provider: { '@id': 'https://intentionaut.com/#person' },
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  isRelatedTo: { '@id': 'https://intentionaut.com/fractional/#service' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'GBP',
    price: rates.fractional,
    priceSpecification: [
      { '@type': 'UnitPriceSpecification', price: fractionalMonthly1Day, priceCurrency: 'GBP', unitText: 'month (1 day a week)' },
      { '@type': 'UnitPriceSpecification', price: fractionalMonthly2Day, priceCurrency: 'GBP', unitText: 'month (2 days a week)' },
      { '@type': 'UnitPriceSpecification', price: rates.fractional, priceCurrency: 'GBP', unitText: 'day' },
    ],
    availability: 'https://schema.org/LimitedAvailability',
  },
};
---

<BaseLayout
  title="Interim CPO UK | Saielle DaSilva"
  description="Interim CPO for UK companies, from a product leader who has run product and design teams at StepStone and Sainsbury's and taken AI into production."
  jsonLd={serviceSchema}
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Interim CPO, UK</p>
      <h1>Interim CPO for UK companies</h1>
      <p class="lede">
        Saielle DaSilva has run product and design teams at StepStone and
        Sainsbury's, and moved AI from pilots into products used by millions.
        As interim CPO, she leads your product team and its hardest decisions
        until a permanent leader starts.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a free call <span class="sr-only">(opens in a new tab)</span></a>
      </div>
    </header>

    <div class="prose">
      <h2>What is an interim CPO?</h2>
      <p>
        An interim CPO covers the gap. You get senior product leadership now,
        without a long search. I join as your product leader for a set time.
        Usually it is one or two days a week, over three to six months.
      </p>
      <p>
        I have executive access. I lead the team, make the hard calls and stay
        accountable for delivery. It is not advice from the sidelines.
      </p>

      <h2>When does it make sense?</h2>
      <ul>
        <li>Your CPO or head of product has left.</li>
        <li>You are hiring a permanent leader and need cover until they start.</li>
        <li>Growth has outrun the team and nobody senior is leading it.</li>
        <li>You are building AI products and nobody can say what good looks like yet.</li>
      </ul>

      <h2>What does the cover look like?</h2>
      <ul>
        <li>Product direction and the decisions that keep slipping.</li>
        <li>Day-to-day leadership of the product and design team.</li>
        <li>A clear handover when it ends: a working team, and an operating model that runs without me.</li>
      </ul>

      <h2>Has this worked before?</h2>
      <ul>
        <li>As interim CPO at a direct-to-consumer grocery scaleup, monthly recurring revenue grew 450 per cent in 90 days.</li>
        <li>I led the product and design organisation at StepStone, with a 3.2x return on investment.</li>
      </ul>

      <h2>How does it work?</h2>
      <dl class="ledger">
        <div><dt>Time a week</dt><dd>One or two days</dd></div>
        <div><dt>Minimum commitment</dt><dd>One month</dd></div>
        <div><dt>Notice</dt><dd>30 days, either side</dd></div>
      </dl>
      <p>
        Rates are on the <a href="/fractional/">fractional page</a>. The work
        is the same. Interim is the name for cover while you fill a gap.
      </p>

      <h2>How do you start?</h2>
      <p>
        A free call. We check it is a fit. If it is, you get a written
        proposal: what I would do, when, and what it costs.
      </p>
    </div>

    <section class="contact-form-section" aria-label="Get in touch">
      <div class="contact-card">
        <h2>Ask for a proposal.</h2>
        <p class="form-lede">
          Tell me who has left, what is slipping, and when you need cover. If it fits, you get a written proposal.
        </p>
        <ContactForm source="interim-cpo" selected="fractional" booking referral />
      </div>
    </section>
  </section>
</BaseLayout>
