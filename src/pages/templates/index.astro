---
import Plate from '../../components/Plate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { templates } from '../../data/templates';
---

<BaseLayout
  title="Free templates for product and AI teams | Saielle DaSilva"
  description="Free, printable templates from Saielle DaSilva: the Impact First AI tools for rating AI ways of working and shaping AI product strategy. CC BY 4.0."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Templates</p>
      <h1>Free templates to run with your team.</h1>
      <p class="lede">
        Print them, fill them in together, adapt them. Every template here is
        free to share under CC BY 4.0.
      </p>
    </header>

    <section class="rates-section" id="impact-first-ai" aria-labelledby="impact-first-ai-h">
      <h2 id="impact-first-ai-h">Impact First AI</h2>
      <p class="prose">
        Start from the impact the work should make, then work back to the work.
        Two tools, each answering one question. Use them on their own or in order.
      </p>
      <div class="rates">
        {templates.map((t, i) => (
          <a class="rate-row rate-card envelope" href={`/templates/${t.slug}/`}>
            <Plate name={t.icon} tone={i % 2 ? 'blue' : 'pink'} />
            <p class="eyebrow">{t.question}</p>
            <p class="rate-name">{t.title}</p>
            <p class="rate-desc">{t.expand && <><span class="expand">{t.expand.map((w, k) => <>{k > 0 && ', '}<strong>{w[0]}</strong>{w.slice(1)}</>)}.</span>{' '}</>}{t.card}</p>
            <p class="rate-shape">{t.pages}, free.</p>
          </a>
        ))}
      </div>
      <p>
        <a class="link-arrow" href="/workshops/ai-strategy/"><span>Want someone outside the team to run it with you?</span></a>
      </p>
    </section>
  </section>
</BaseLayout>
