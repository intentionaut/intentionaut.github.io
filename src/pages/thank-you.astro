---
import '@fontsource-variable/roboto-serif';
import BaseLayout from '../layouts/BaseLayout.astro';
import Recommendations from '../components/Recommendations.astro';
import { recommendations } from '../data/writing';
---

<BaseLayout
  title="You're in | Saielle DaSilva"
  description="Your subscription to Intentionaut is confirmed. Here's what to read first."
  noindex
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Intentionaut</p>
      <h1>You're in.</h1>
      <p class="lede">
        Your subscription is confirmed. The next issue lands every other
        Wednesday: five to fifteen minutes on setting direction teams can act
        on, across product, design and data.
      </p>
      <p class="ty-tip">
        One thing worth doing now: add
        <strong>saielle@mail.intentionaut.com</strong> to your contacts, so the
        letter lands in your inbox and not a tab you never open.
      </p>
    </header>

    <Recommendations items={recommendations} heading="Here's what to read first" />
  </section>
</BaseLayout>

<style>
  .ty-tip {
    margin-top: var(--space-4);
    max-width: 52ch;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .ty-tip strong {
    color: var(--ink);
    font-weight: 500;
  }
</style>
