---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Saielle DaSilva"
  description="That page got away. May I offer you some alternatives?"
>
  <section class="wrap err" aria-label="Page not found">
    <p class="eyebrow">404</p>
    <h1>May I offer you some alternatives?</h1>
    <p class="lede">
      Perhaps back to the start? No? Maybe an article, then.
    </p>
    <div class="cta-row">
      <a class="btn-primary" href="/">Back to the start</a>
      <a class="link-arrow" href="/writing">Back to writing</a>
    </div>
  </section>
</BaseLayout>
