---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Saielle DaSilva"
  description="That page got away. May I offer you some alternatives?"
>
  <section class="wrap err" aria-label="Page not found">
    <p class="eyebrow"><span class="err-keyline">404</span></p>
    <h1>May I offer you some alternatives?</h1>
    <p class="lede">
      Back to the homepage? No? Perhaps an article then.
    </p>
    <div class="cta-row">
      <a class="btn-primary" href="/">Home</a>
      <a class="link-arrow" href="/writing/">Perhaps an article</a>
    </div>
  </section>
</BaseLayout>
