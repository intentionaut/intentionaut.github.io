---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Saielle DaSilva"
  description="That page lost its intention. Head back to the start."
>
  <section class="wrap err" aria-label="Page not found">
    <p class="eyebrow">404</p>
    <h1>This page has lost its intention.</h1>
    <p class="lede">
      The link led you somewhere that does not exist. The nav below still
      knows where it is going.
    </p>
    <div class="cta-row">
      <a class="btn-primary" href="/">Back to the start</a>
      <a class="link-arrow" href="/writing">Or read something anyway</a>
    </div>
  </section>
</BaseLayout>
