---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries } from '../../data/open-source';
import ReleaseSubscribe from '../../components/ReleaseSubscribe.astro';

const flagship = entries.filter((e) => e.tier === 'flagship');
const projects = entries.filter((e) => e.tier === 'project');
const contributions = entries
  .filter((e) => e.tier === 'contribution')
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
---

<BaseLayout
  title="Open source | Saielle DaSilva"
  description="Open source from Intentionaut: the tools I use for my own work, given away, plus smaller projects and contributions to other people's."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Open source</p>
      <h1>Tools I use, given away.</h1>
      <p class="lede">
        Everything here started as an idea for something that might help my own
        work. These are tools I use to do my work. You can have them too.
      </p>
    </header>

    <h2 class="os-tier">Flagship</h2>
    <ol class="release-list">
      {flagship.map((r) => (
        <li class="release-card">
          <a class="release-link" href={`/open-source/${r.slug}/`}>
            <h3>{r.name}</h3>
            <p>{r.line}</p>
          </a>
          <div class="release-meta">
            {r.install && <span class="pill"><span class="pill-prompt">$</span> {r.install}</span>}
            <a class="link-arrow" href={r.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </li>
      ))}
    </ol>

    {projects.length > 0 && (
      <>
        <h2 class="os-tier">Projects</h2>
        <ul class="os-list">
          {projects.map((r) => (
            <li>
              <a href={r.repo} target="_blank" rel="noopener noreferrer"><strong>{r.name}</strong></a>
              <span>{r.line}</span>
              {r.install && <span class="pill"><span class="pill-prompt">$</span> {r.install}</span>}
            </li>
          ))}
        </ul>
      </>
    )}

    {contributions.length > 0 && (
      <>
        <h2 class="os-tier">Contributions</h2>
        <p class="os-note">Pull requests, patterns and fixes that went into other people's projects.</p>
        <ul class="os-list">
          {contributions.map((r) => (
            <li>
              <a href={r.repo} target="_blank" rel="noopener noreferrer"><strong>{r.name}</strong></a>
              {r.to && <em>to {r.to}</em>}
              <span>{r.line}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    <ReleaseSubscribe source="open-source" />

    <p class="os-note os-foot">
      Something here saved you an afternoon? <a href="/contact/">Tell me</a>. That
      is the whole business model.
    </p>
  </section>
</BaseLayout>

<style>
  /* Tier labels are headings set as eyebrows: one small label per group. The
     first sits on the page intro's gap alone; each later tier is one section
     gap below the list before it. */
  .os-tier {
    margin: clamp(3rem, 6vw, 5rem) 0 var(--space-4);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .page-head + .os-tier {
    margin-top: 0;
  }
  .release-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  /* The design system's Card: an ink rule, a slate rule inset 3px, square
     corners, ink text. */
  .release-card {
    position: relative;
    border: 1px solid var(--ink);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-5);
  }
  .release-card::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid var(--slate);
    pointer-events: none;
  }
  .release-link {
    position: relative;
    z-index: 1;
    text-decoration: none;
    color: inherit;
  }
  .release-link h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: 0;
    transition: color var(--dur-base) ease;
  }
  .release-link:hover h3 {
    color: var(--accent-text);
  }
  .release-link p {
    margin: 0;
    max-width: 62ch;
    color: var(--ink);
  }
  .release-meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .os-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .os-list li {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) max-content;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--slate);
  }
  .os-list em {
    color: var(--muted);
    font-style: normal;
    font-size: var(--text-sm);
  }
  .os-list span:not(.pill):not(.pill-prompt) {
    color: var(--muted);
  }
  .os-note {
    color: var(--muted);
    max-width: 62ch;
  }
  .os-foot {
    margin: clamp(3rem, 6vw, 5rem) 0;
    color: var(--ink);
  }
  .os-foot a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .os-foot a:hover {
    color: var(--accent-text);
  }
  @media (max-width: 700px) {
    .os-list li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
