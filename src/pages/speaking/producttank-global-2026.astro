---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';

// Placeholder until the talk on 18 Nov 2026; the full resources pack replaces it just before the talk.
const signup =
  'https://go.mindtheproduct.com/november-product-tank-webinar-register?utm_source=saielle&utm_medium=socials&utm_campaign=ptankglobal';
---

<BaseLayout
  title="How do you manage AI agents as a product leader? | Saielle DaSilva"
  description="Saielle DaSilva at ProductTank Global, 18 November 2026: from AI skeptic to running a team of agents. Sign up, and get the resources pack."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Speaking · ProductTank Global</p>
      <h1>How do you manage AI agents as a product leader?</h1>
      <p class="lede">
        Saielle DaSilva went from AI skeptic to running a small team of agents
        that build, test and ship alongside her. In this screen-open session
        she walks through a real working day: the controls that keep agents on
        budget and auditable, the checks that keep the work honest, and the
        habits that let a product person defend every decision her agents make.
      </p>
      <p class="talk-when">
        Wednesday 18 November 2026, 1pm GMT (8am ET), online. Free, and
        recorded.
      </p>
      <p><a class="btn-primary" href={signup} target="_blank" rel="noopener noreferrer">Sign up for the talk</a></p>
    </header>

    <h2>The resources pack</h2>
    <p>
      Everything from the talk in one place: Dualtrack Agents, the open source
      agentic product team Saielle runs, ready to install; the tools she uses;
      and the write-up. Subscribe and the pack arrives in your welcome email.
    </p>
    <SubscribeForm
      variant="inline"
      source="talk"
      campaign="producttank-global-2026"
      emailId="talk-email"
      buttonLabel="Get the pack"
    />
  </section>
</BaseLayout>

<style>
  .talk-when {
    margin-top: var(--space-4);
    font-weight: 600;
  }
</style>
