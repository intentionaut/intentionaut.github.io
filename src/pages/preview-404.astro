---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 preview | Saielle DaSilva"
  description="Four Grand Budapest flavored 404 designs to compare."
>
  <style>
    .preview-head {
      padding-block: var(--space-8) var(--space-5);
      border-bottom: 1px solid var(--line);
    }
    .preview-head h1 {
      max-width: none;
      font-size: clamp(1.8rem, 4vw, 2.6rem);
    }
    .preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-7);
      padding-block: var(--space-8) var(--space-10);
    }
    .pv-card {
      border: 1px solid var(--line);
      border-radius: var(--radius-l);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .pv-card .pv-title {
      padding: var(--space-3) var(--space-5);
      border-bottom: 1px solid var(--line);
      font-family: var(--font-display);
      font-size: 0.9rem;
      color: var(--muted);
      letter-spacing: 0.05em;
    }
    .pv-stage {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: var(--space-8) var(--space-6);
      gap: var(--space-4);
    }
    .pv-stage h2 {
      max-width: 16ch;
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      margin: 0;
    }
    .pv-stage p {
      max-width: 42ch;
      margin: 0;
      color: var(--muted);
      font-family: var(--font-body);
    }
    .pv-row {
      display: flex;
      gap: var(--space-4);
      margin-block-start: var(--space-4);
    }

    /* A: silhouette scene */
    .pv-silhouette {
      width: 240px;
      height: auto;
      display: block;
    }

    /* C: telegram stamp */
    .pv-stamp {
      font-family: var(--font-body);
      font-size: 0.85rem;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--accent);
      padding-bottom: var(--space-2);
      border-bottom: 2px solid var(--accent);
      display: inline-block;
    }

    /* D: lozenge band */
    .pv-band {
      height: 10px;
      width: 100%;
      margin-block: var(--space-2);
      background: repeating-linear-gradient(
        45deg,
        var(--accent) 0 14px,
        var(--paper) 14px 18px
      );
    }

    .pv-btn {
      display: inline-block;
      background: var(--ink);
      color: var(--paper);
      padding: 0.6em 1.1em;
      border-radius: var(--radius-m);
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 0.95rem;
    }
    .pv-link {
      color: var(--accent);
      text-decoration: underline;
      font-family: var(--font-body);
    }
  </style>

  <section class="wrap">
    <header class="page-head preview-head">
      <p class="eyebrow">Design preview</p>
      <h1>Four Grand Budapest 404s.</h1>
      <p class="lede">
        Same copy, four design leans. Pick the one that fits.
      </p>
    </header>

    <div class="preview-grid">
      <!-- A: silhouette -->
      <div class="pv-card">
        <div class="pv-title">A · Hotel silhouette</div>
        <div class="pv-stage">
          <svg class="pv-silhouette" viewBox="0 0 240 120" role="img" aria-label="line hotel">
            <g fill="none" stroke="#c85060" stroke-width="3">
              <path d="M30 100 L30 55 L78 30 L78 55" />
              <path d="M78 100 L78 55 L126 30 L126 55" />
              <path d="M126 100 L126 55 L174 30 L174 55" />
              <path d="M174 100 L174 55 L210 70 L210 100" />
              <rect x="30" y="55" width="144" height="16" />
              <rect x="30" y="79" width="180" height="4" />
              <path d="M60 100 L60 100" />
              <path d="M0 118 L240 100" />
            </g>
            <circle cx="54" cy="45" r="3" fill="#c85060" />
            <circle cx="102" cy="45" r="3" fill="#c85060" />
            <circle cx="150" cy="45" r="3" fill="#c85060" />
          </svg>
          <p class="pv-stamp">404</p>
          <h2>Whoops, that's probably not where you intended to go.</h2>
          <p>The links below still know where to go.</p>
          <div class="pv-row">
            <a class="pv-btn" href="#">Back to the start</a>
            <a class="pv-link" href="#">Back to writing</a>
          </div>
        </div>
      </div>

      <!-- B: zero zero zero -->
      <div class="pv-card">
        <div class="pv-title">B · Zero zero zero wink</div>
        <div class="pv-stage">
          <p class="pv-stamp">404</p>
          <h2>Whoops, that's probably not where you intended to go.</h2>
          <p>The links below still know where to go.</p>
          <p style="font-family:var(--font-display);font-style:italic;color:var(--accent);font-size:1.1rem;margin:0;">
            Room 404. Zero zero zero.
          </p>
          <div class="pv-row">
            <a class="pv-btn" href="#">Back to the start</a>
            <a class="pv-link" href="#">Back to writing</a>
          </div>
        </div>
      </div>

      <!-- C: telegraph stamp -->
      <div class="pv-card">
        <div class="pv-title">C · Telegraph stamp</div>
        <div class="pv-stage">
          <p class="pv-stamp">404</p>
          <h2>Whoops, that's probably not where you intended to go.</h2>
          <p>The links below still know where to go.</p>
          <div class="pv-band" style="max-width:120px;" />
          <div class="pv-row">
            <a class="pv-btn" href="#">Back to the start</a>
            <a class="pv-link" href="#">Back to writing</a>
          </div>
        </div>
      </div>

      <!-- D: lozenge band -->
      <div class="pv-card">
        <div class="pv-title">D · Pink lozenge band</div>
        <div class="pv-stage">
          <p class="pv-stamp">404</p>
          <h2>Whoops, that's probably not where you intended to go.</h2>
          <p>The links below still know where to go.</p>
          <div class="pv-band" />
          <div class="pv-row">
            <a class="pv-btn" href="#">Back to the start</a>
            <a class="pv-link" href="#">Back to writing</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
