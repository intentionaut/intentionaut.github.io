---
import '@fontsource-variable/roboto-serif';
import BaseLayout from '../layouts/BaseLayout.astro';

const TURNSTILE_SITEKEY = '0x4AAAAAAEcCwzuExy2fSCmH';
---

<BaseLayout
  title="Product Leadership Mentoring | Saielle DaSilva"
  description="A few mentoring slots each month for people moving from doing the work to leading it, across design, product, data and AI."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Mentoring</p>
      <h1>Someone did this for me. Now I do it for others.</h1>
      <p class="lede">
        A few slots each month for people finding their footing across
        disciplines.
      </p>
    </header>

    <div class="prose">
      <p>
        Early in my career, people of various disciplines helped me learn to
        translate people and culture into great software. Designers, engineers,
        researchers, leaders. None of them had to. They did it because someone
        had done it for them.
      </p>
      <p>
        I like giving back. That is why I keep a few mentoring slots open each
        month. Not for career coaching or CV review. For the harder stuff:
        figuring out what kind of work suits you, how to navigate organisations
        that were not built with you in mind, and how to turn craft into
        leadership without losing what made you good at it in the first place.
      </p>

      <h2>Who it is for</h2>
      <ul>
        <li>
          People early in their career across design, product, data or
          engineering who want to think bigger about where they are headed
        </li>
        <li>
          People mid-career who are stuck between doing the work and leading
          the people who do it
        </li>
        <li>
          Anyone who has felt like the room was not designed for them and
          wants to talk through what that means for their path
        </li>
      </ul>

      <h2>How it works</h2>
      <p>
        A 45-minute conversation, once a month. No agenda, no homework, no
        commitment beyond showing up honestly. We talk about what is actually
        going on, not what sounds good in a performance review.
      </p>
      <p>
        I do not have all the answers. What I have is perspective from a
        career that moved across design, data, AI and leadership, and a
        genuine interest in helping people who are building something that
        matters.
      </p>
    </div>

    <section class="contact-form-section" aria-label="Get in touch">
      <div class="contact-card">
        <h2>Let's talk.</h2>
        <p class="form-lede">
          If any of that sounds like it might help, get in touch. I read
          every message.
        </p>
        <form id="contact-form" novalidate>
          <input type="hidden" name="source" value="mentoring" />
          <div class="form-grid">
            <label>
              <span class="form-label">Name</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label>
              <span class="form-label">Email</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
          </div>
          <label>
            <span class="form-label">What's this about?</span>
            <select name="topic">
              <option value="strategic-direction">
                Strategic direction
              </option>
              <option value="execution">Execution &amp; transformation</option>
              <option value="fractional">Fractional leadership</option>
              <option value="advisory">Advisory</option>
              <option value="speaking">Speaking &amp; workshops</option>
              <option value="mentoring" selected>Mentoring</option>
              <option value="other">Something else</option>
            </select>
          </label>
          <label>
            <span class="form-label">Message</span>
            <textarea name="message" rows="5" required></textarea>
          </label>
          {
            TURNSTILE_SITEKEY && (
              <>
                <div
                  class="cf-turnstile"
                  data-sitekey={TURNSTILE_SITEKEY}
                  data-theme="light"
                />
                <script
                  is:inline
                  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                  async
                  defer
                />
              </>
            )
          }
          <button class="btn-plain" type="submit">Send it</button>
          <p class="form-status" id="form-status" role="status"></p>
        </form>
      </div>
      <p class="faq-link">
        Questions first? <a href="/faq/">Read the FAQ.</a>
      </p>
    </section>
  </section>

  <script>
    const ENDPOINT = 'https://contact-form.intentionaut.workers.dev/contact';
    const form = document.getElementById('contact-form');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const statusEl = document.getElementById('form-status');

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (res.ok) {
          form.reset();
          if (statusEl) statusEl.textContent = result.message || "Thank you; I'll reply soon.";
        } else {
          if (statusEl) statusEl.textContent = result.error || 'Something went wrong; please email me directly.';
        }
      } catch {
        if (statusEl) statusEl.textContent = 'Something went wrong; please email me directly.';
      }
    });
  </script>
</BaseLayout>
