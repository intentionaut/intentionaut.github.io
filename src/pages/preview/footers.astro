---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/jost';
import '../../styles/global.css';
import FrameSubscribe from '../../components/FrameSubscribe.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Footer &amp; signup preview | Intentionaut</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="pf-stage">
      <header class="pf-top">
        <p class="eyebrow">Design preview</p>
        <h1>Newsletter signup and footer, as shipped.</h1>
        <p class="pf-lede">
          Two production pieces: the frame-subscribe signup card above the
          footer, then the footer as a short colophon over the three columns.
        </p>
      </header>

      <!-- frame-subscribe: the signup card, part of the page ----------------- -->
      <section class="signup">
        <div class="wrap">
          <FrameSubscribe
            eyebrow="Newsletter"
            heading="Intentionaut is a fortnightly letter on design, product, data and AI. What is working, what isn't, and how to keep your bearings."
            source="preview"
            emailId="preview-email"
            buttonLabel="Subscribe"
          />
        </div>
      </section>

      <!-- footer: short colophon over the columns ---------------------------- -->
      <Footer />
    </div>

    <style is:global>
      :root {
        --paper: #f7e9e0;
        --ink: #38234a;
        --muted: #74607b;
        --slate: #e0d2cb;
        --accent: #c85060;
        --font-display: 'Fraunces Variable', Georgia, serif;
        --font-body: 'Jost Variable', Futura, sans-serif;
        --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem; --space-4: 1rem;
        --space-5: 1.25rem; --space-6: 1.5rem; --space-7: 2rem; --space-8: 2.5rem;
        --space-9: 3rem; --space-10: 4rem;
        --dur-fast: 0.15s; --dur-med: 0.25s;
        --wrap: 72rem;
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
      }

      .pf-stage {
        max-width: var(--wrap);
        margin: 0 auto;
        padding: clamp(2rem, 5vw, 4rem) var(--space-6);
      }

      .pf-top {
        padding-bottom: var(--space-9);
        border-bottom: 1px solid var(--slate);
      }

      .pf-top h1 {
        font-family: var(--font-display);
        font-weight: 560;
        font-size: clamp(1.9rem, 4vw, 2.6rem);
        letter-spacing: -0.015em;
        line-height: 1.08;
        margin: 0 0 var(--space-3);
        color: var(--ink);
      }

      .pf-lede {
        max-width: 52ch;
        margin: 0;
        color: var(--muted);
        font-size: 1rem;
      }

      .signup {
        text-align: center;
        padding-block: var(--space-7);
      }
    </style>
  </body>
</html>