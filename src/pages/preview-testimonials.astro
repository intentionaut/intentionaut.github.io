---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Testimonials preview | Saielle DaSilva"
  description="Red-accented double-border testimonial cards."
>
  <style>
    .preview-head {
      padding-block: var(--space-8) var(--space-5);
      border-bottom: 1px solid var(--line);
    }
    .preview-head h1 {
      max-width: none;
      font-size: clamp(1.8rem, 4vw, 2.6rem);
    }
    .preview-panel {
      padding-block: clamp(3.5rem, 7vw, 5.5rem);
      border-bottom: 1px solid var(--line);
    }
    .preview-panel .panel-label {
      font-family: var(--font-body);
      font-size: 0.85rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: var(--space-6);
    }
    .preview-panel h2 {
      font-size: 1.7rem;
      margin-bottom: var(--space-7);
    }

    /* Shared card shell: double border like .rate-card / .contact-card */
    .tcard {
      position: relative;
      border: 1px solid var(--ink);
      background: var(--paper);
      padding: var(--space-6) var(--space-7);
      display: flex;
      flex-direction: column;
    }
    .tcard::after {
      content: '';
      position: absolute;
      inset: 3px;
      border: 1px solid var(--line);
      pointer-events: none;
    }
    .tcard .q {
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-size: 1.05rem;
      line-height: 1.5;
      margin: 0 0 var(--space-4);
    }
    .tcard .a {
      font-family: var(--font-body);
      font-size: 0.85rem;
      color: var(--muted);
      margin: 0;
    }

    .t-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-5);
    }

    /* ---- Red accents (site --accent #c85060) ---- */

    /* R1: red top keyline */
    .r1::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: var(--accent);
      z-index: 1;
    }

    /* R2: red left rule + divider line under quote */
    .r2 {
      justify-content: space-between;
    }
    .r2::before {
      content: '';
      position: absolute;
      top: var(--space-6);
      bottom: var(--space-6);
      left: 0;
      width: 4px;
      background: var(--accent);
    }
    .r2 .q {
      border-bottom: 1px solid var(--line);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-4);
    }

    /* R3: red opening quote mark */
    .r3::before {
      content: '“';
      position: absolute;
      top: -0.4rem;
      left: var(--space-5);
      font-family: var(--font-display);
      font-size: 4.5rem;
      line-height: 1;
      color: var(--accent);
    }
    .r3 {
      padding-top: calc(var(--space-6) + 1rem);
    }
  </style>

  <section class="wrap">
    <header class="page-head preview-head">
      <p class="eyebrow">Testimonials · red accents</p>
      <h1>Red-accented cards, on top of the settled one.</h1>
      <p class="lede">
        The plain double-border card stays. Below are three new red-accent
        variants, consistent with the site palette.
      </p>
    </header>
  </section>

  <section class="preview-panel" aria-label="Settled plain double-border cards">
    <div class="wrap">
      <p class="panel-label">Baseline · plain double-border card</p>
      <h2>Why people keep working with me</h2>
      <div class="t-grid">
        <div class="tcard">
          <p class="q">
            Saielle doesn't tell you what you want to hear. She names the
            decision you've been avoiding and gives you the frame to make it,
            then she stays until it lands.
          </p>
          <p class="a">Chief Product Officer · UK scale-up</p>
        </div>
        <div class="tcard">
          <p class="q">
            She gave our talk on higher impact product decisions, and the room
            hasn't made the same misaligned choice since. Teams that had never
            questioned the plan started asking which one thing mattered most.
          </p>
          <p class="a">Product leader · Sainsbury's</p>
        </div>
        <div class="tcard">
          <p class="q">
            The rare leader who can go from a whiteboard strategy to shipped
            code in the same week. She brought our AI story into focus when
            nobody else could.
          </p>
          <p class="a">Founder &amp; CEO · pre-seed AI startup</p>
        </div>
      </div>
    </div>
  </section>

  <!-- R1: red top keyline -->
