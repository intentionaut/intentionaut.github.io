---
import Plate from '../components/Plate.astro';
import { iconFor } from '../data/icons';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { BOOKING_URL } from '../data/links';
import { rates, gbp, fractionalMonthly1Day, fractionalMonthly2Day, buildingWeekly } from '../data/rates';
import { faqsFor } from '../data/faqs';
import { testimonialsFor } from '../data/testimonials';
import FaqList from '../components/FaqList.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { LOCATION_LINE } from '../data/positioning';


// Edit src/data/testimonials.ts to add one, reorder them, or take one down.
// Nothing on this page needs touching for any of that.
const testimonials = testimonialsFor('contact');

// The priced cards below, as data. Each price comes from rates.ts, the same
// value the card shows. Fractional and product building point at the Service
// nodes on their own pages rather than describing them twice. Mentoring has
// no published price, so it is left out.
const offer = (itemOffered: Record<string, unknown>, price: number, unitText: string) => ({
  '@type': 'Offer',
  itemOffered,
  priceCurrency: 'GBP',
  price,
  priceSpecification: { '@type': 'UnitPriceSpecification', price, priceCurrency: 'GBP', unitText },
});
const offerCatalog = {
  '@type': 'OfferCatalog',
  '@id': 'https://intentionaut.com/contact/#offers',
  name: 'Services and rates',
  itemListElement: [
    offer(
      { '@type': 'Service', name: 'Office hours', provider: { '@id': 'https://intentionaut.com/#person' }, url: 'https://intentionaut.com/office-hours/' },
      rates.strategySession,
      '90-minute session'
    ),
    offer({ '@id': 'https://intentionaut.com/fractional/#service' }, fractionalMonthly1Day, 'month (1 day a week)'),
    offer({ '@id': 'https://intentionaut.com/fractional/#service' }, fractionalMonthly2Day, 'month (2 days a week)'),
    offer({ '@id': 'https://intentionaut.com/fractional/#service' }, rates.fractional, 'day'),
    offer({ '@id': 'https://intentionaut.com/forward-deployed/#service' }, buildingWeekly, 'week'),
    offer(
      { '@type': 'Service', name: 'Speaking and workshops', provider: { '@id': 'https://intentionaut.com/#person' }, url: 'https://intentionaut.com/keynote-speaker/' },
      rates.keynote,
      'keynote'
    ),
    offer(
      { '@type': 'Service', name: 'Team workshop', provider: { '@id': 'https://intentionaut.com/#person' }, url: 'https://intentionaut.com/workshops/' },
      rates.workshop,
      'full-day workshop'
    ),
  ],
};
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqsFor('contact').map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer.replace(/\s+/g, ' ').trim() },
  })),
};
---

<BaseLayout
  title="Contact & rates | Fractional CPO, London | Saielle DaSilva"
  description={`Work with Saielle DaSilva: advisory, fractional product leadership, speaking and mentoring. ${LOCATION_LINE}`}
  jsonLd={[offerCatalog, faqSchema]}
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Contact &amp; rates</p>
      <h1>Work with me.</h1>
      <p class="lede">
        Got a product team doing something important, while AI keeps changing
        the rules under you? That gap is where I work. I help teams and
        organisations turn noisy ambition into clear decisions, across
        design, data and AI. {LOCATION_LINE}
      </p>
      <div class="cta-row">
        <a class="btn-primary" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a free call</a>
        <a class="link-arrow" href="#contact-section"><span>Send a message</span></a>
      </div>
    </header>

    <section class="rates-section" aria-label="Which one fits?">
      <h2>Which one fits?</h2>
      <div class="rates">
        <a class="rate-row rate-card envelope" href="/office-hours/">
          <Plate name={iconFor('/office-hours/')} tone="pink" />
          <p class="rate-name">Office hours</p>
          <p class="rate-price">{gbp(rates.strategySession)} · 90 min</p>
          <p class="rate-desc">
            A sounding board for founders and product leaders: strategy
            reviews, roadmap calls, hiring help, AI reality-checks.
          </p>
          <p class="rate-scale">Sliding scale · Yes</p>
        </a>
        <a class="rate-row rate-card envelope" href="/fractional/">
          <Plate name={iconFor('/fractional/')} tone="blue" />
          <p class="rate-name">Fractional leadership</p>
          <p class="rate-price">From {gbp(fractionalMonthly1Day)} a month</p>
          <p class="rate-desc">
            Head of product for teams that need direction now, one or two
            days a week.
          </p>
          <p class="rate-shape">One day a week ({gbp(fractionalMonthly1Day)} a month) or two ({gbp(fractionalMonthly2Day)} a month). One month minimum, then 30 days' notice. Day rate {gbp(rates.fractional)}.</p>
        </a>
        <a class="rate-row rate-card envelope" href="/forward-deployed/">
          <Plate name={iconFor('/forward-deployed/')} tone="pink" />
          <p class="rate-name">Product building</p>
          <p class="rate-price">{gbp(buildingWeekly)} / week</p>
          <p class="rate-desc">
            Three days a week inside your team, building a working prototype
            in your environment.
          </p>
          <p class="rate-shape">Three days a week, four to twelve weeks.</p>
        </a>
        <a class="rate-row rate-card envelope" href="/keynote-speaker/">
          <Plate name={iconFor('/keynote-speaker/')} tone="blue" />
          <p class="rate-name">Speaking &amp; workshops</p>
          <p class="rate-price">Keynote from {gbp(rates.keynote)}</p>
          <p class="rate-desc">
            From conference keynotes to hands-on team sessions about building
            with intention across design, data and AI.
          </p>
          <p class="rate-shape">Team workshops from {gbp(rates.workshopTaster)}: half day {gbp(rates.workshopHalfDay)}, full day {gbp(rates.workshop)}.</p>
          <p class="rate-scale">Sliding scale · Yes</p>
        </a>
        <a class="rate-row rate-card envelope" href="/mentoring/">
          <Plate name={iconFor('/mentoring/')} tone="pink" />
          <p class="rate-name">Mentoring</p>
          <p class="rate-price">Get in touch</p>
          <p class="rate-desc">
            A few slots each month for people finding their footing across
            disciplines. That was my path too.
          </p>
        </a>
      </div>
      <p class="rates-note">
        Placing a fractional or interim product person? The short version for
        advisors and recruiters is <a href="/for-advisors/">over here</a>.
      </p>
    </section>



    {/* What happens, then do it: the steps and the form side by side. */}
    <div class="start-band">
    <section class="how-section" aria-label="How it works">
      <style>
        .how-section {
          padding-bottom: clamp(3rem, 6vw, 5rem);
        }
        .how-section h2 {
          font-size: var(--text-lg);
          margin-bottom: var(--space-7);
        }
        .how-steps {
          list-style: none;
          margin: 0;
          padding: 0;
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: var(--space-9);
          border-top: 1px solid var(--ink);
        }
        .how-step {
          padding-top: var(--space-4);
        }
        .how-step .num {
          display: block;
          font-family: var(--font-display);
          font-optical-sizing: auto;
          font-style: italic;
          font-size: 2.1rem;
          line-height: 1;
          margin-bottom: var(--space-3);
          color: var(--accent);
          opacity: 0.85;
        }
        .how-step h3 {
          font-size: var(--text-md);
          margin-bottom: var(--space-2);
        }
        .how-step p {
          margin: 0;
          font-size: 0.95rem;
          color: var(--muted);
          line-height: 1.6;
        }
        @media (max-width: 720px) {
          .how-steps {
            grid-template-columns: 1fr;
            gap: var(--space-7);
          }
        }
      </style>
      <h2>How it works</h2>
      <ol class="how-steps">
        <li class="how-step">
          <span class="num">01</span>
          <h3>You write in</h3>
          <p>
            A few lines about what you are working on.
          </p>
        </li>
        <li class="how-step">
          <span class="num">02</span>
          <h3>We scope it on a call</h3>
          <p>
            A short call to check it is a fit. Then you get a written
            proposal: what we would do, when, and what it costs.
          </p>
        </li>
      </ol>
    </section>

    <section class="contact-form-section" id="contact-section" aria-label="Send a message">
      <div class="contact-card">
        <h2>Leave me a note.</h2>
        <p class="form-lede">
          Tell me what you're working on, and I'll tell you how I can help.
        </p>
        <ContactForm rows={3} selected="other" booking />
      </div>
    </section>
    </div>

    {/* Hidden entirely when nothing is enabled for this page, rather than
        leaving a heading over an empty carousel. An empty state should mean
        "there are none", and here there being none is a choice. */}
    <TestimonialCarousel
      testimonials={testimonials}
      sub="I leave organisations clearer about what matters. See for yourself."
    />

    <FaqList
      heading="FAQ: Rates and engagements with Saielle DaSilva"
      items={faqsFor('contact')}
      sub="Rates, sliding scale and how engagements run. Anything missing: ask me."
    />
  </section>

  <script>
    const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    faqItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        faqItems.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .start-band {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-10);
    align-items: start;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .start-band .how-section {
    padding-bottom: 0;
  }
  .start-band .how-steps {
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  /* The card starts level with the rule under "How it works": the heading's
     height (one line of --text-lg at line-height 1.08) plus its margin. */
  .start-band .contact-form-section {
    max-width: none;
    margin: calc(var(--text-lg) * 1.08 + var(--space-7)) 0 0;
    /* The band carries the section gap; don't add the form's own on top. */
    padding-bottom: 0;
  }
  @media (max-width: 900px) {
    .start-band {
      grid-template-columns: 1fr;
      gap: var(--space-9);
    }
    .start-band .contact-form-section {
      margin-top: 0;
    }
  }
</style>
