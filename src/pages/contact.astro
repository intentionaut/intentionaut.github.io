---
import '@fontsource-variable/roboto-serif';
import BaseLayout from '../layouts/BaseLayout.astro';

// Cloudflare Turnstile sitekey (dash.cloudflare.com, Turnstile)
const TURNSTILE_SITEKEY = '0x4AAAAAAEcCwzuExy2fSCmH';
---

<BaseLayout
  title="Contact & rates | Saielle DaSilva"
  description="Work with Saielle DaSilva: advisory, fractional product leadership, speaking and mentoring."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Contact &amp; rates</p>
      <h1>Work with me.</h1>
      <p class="lede">
        Got a product team doing something important, while AI keeps changing
        the rules under you? That gap is where I work. I help teams and
        organisations turn noisy ambition into clear decisions, across
        design, data and AI. Email me, or use the form below.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href="#contact-section">Email me</a>
      </div>
    </header>

    <section class="rates-section" aria-label="Ways to work together">
      <h2>Ways to work together</h2>
      <dl class="rates">
        <a class="rate-row rate-card" href="/strategic-direction/">
          <dt>Strategy session</dt>
          <dd class="rate-price">£400 · 90 min</dd>
          <dd class="rate-desc">
            A sounding board for founders and product leaders: strategy
            reviews, roadmap calls, hiring help, AI reality-checks.
          </dd>
          <dd class="rate-scale">Sliding scale · Yes</dd>
        </a>
        <a class="rate-row rate-card" href="/fractional/">
          <dt>Fractional leadership</dt>
          <dd class="rate-price">£1,200 / day</dd>
          <dd class="rate-desc">
            Part-time head of product for early teams that need direction
            now, before they're ready for a full-time hire.
          </dd>
        </a>
        <a class="rate-row rate-card" href="/speaker/">
          <dt>Speaking &amp; workshops</dt>
          <dd class="rate-price">£1,600 / event</dd>
          <dd class="rate-desc">
            From conference keynotes to hands-on team sessions about building
            with intention across design, data and AI.
          </dd>
          <dd class="rate-scale">Sliding scale · Yes</dd>
        </a>
        <a class="rate-row rate-card" href="/mentoring/">
          <dt>Mentoring</dt>
          <dd class="rate-price">Get in touch</dd>
          <dd class="rate-desc">
            A few slots each month for people finding their footing across
            disciplines. That was my path too.
          </dd>
        </a>
      </dl>
    </section>


    <section class="testimonials-section" aria-label="Testimonials">
      <style>
        :root {
          --acc-blue: #a9cbd0;
        }
        .testimonials-section {
          padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
        }
        .testimonials-section h2 {
          font-size: 1.7rem;
          margin: 0 0 var(--space-2);
        }
        .testi-sub {
          margin: 0 0 var(--space-7);
          max-width: 52ch;
          font-size: 1.05rem;
          color: var(--muted);
        }
        .carousel {
          position: relative;
        }
        .carousel-track {
          display: grid;
          grid-auto-flow: column;
          grid-auto-columns: 88%;
          gap: var(--space-6);
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          scrollbar-width: none;
          padding: var(--space-1);
        }
        .carousel-track::-webkit-scrollbar {
          display: none;
        }
        @media (min-width: 720px) {
          .carousel-track {
            grid-auto-columns: calc(100% / 2.2 - var(--space-6));
          }
        }
        .tcard {
          position: relative;
          border: 1px solid var(--ink);
          background: var(--paper);
          padding: var(--space-6) var(--space-7);
          display: flex;
          flex-direction: column;
          scroll-snap-align: start;
          height: 460px;
        }
        .tcard::after {
          content: '';
          position: absolute;
          inset: 3px;
          border: 1px solid var(--line);
          pointer-events: none;
        }
        .tcard .q {
          font-family: var(--font-display);
          font-optical-sizing: auto;
          font-size: 1.12rem;
          line-height: 1.55;
          margin: 0 0 var(--space-4);
          flex: 1 1 auto;
          min-height: 0;
          display: flex;
          flex-direction: column;
          justify-content: center;
        }
        .tcard .a {
          margin: 0;
          flex-shrink: 0;
          min-height: calc(var(--space-9) + var(--space-6));
          display: flex;
          flex-direction: column;
          justify-content: flex-end;
          font-family: var(--font-body);
          font-size: 0.85rem;
          color: var(--muted);
        }
        .tcard .a .name {
          display: block;
          color: var(--ink);
          font-weight: 600;
          font-size: 0.95rem;
          margin-bottom: 0.15em;
          border-top: 1px solid var(--line);
          padding-top: var(--space-4);
        }
        .tcard .a .name a {
          color: inherit;
          text-decoration: none;
        }
        .tcard .a .name a:hover,
        .tcard .a .role a:hover {
          text-decoration: underline;
          text-decoration-color: var(--accent);
        }
        .tcard .a .role {
          display: block;
          font-style: italic;
        }
        .tcard .a .role a {
          color: var(--muted);
          text-decoration: none;
        }
        .carousel-controls {
          display: flex;
          align-items: center;
          gap: var(--space-3);
          margin-top: var(--space-6);
        }
        .car-arrow {
          position: relative;
          z-index: 0;
          appearance: none;
          background: var(--paper);
          border: 1px solid var(--ink);
          color: var(--ink);
          font-family: var(--font-body);
          font-size: 0.78rem;
          font-weight: 600;
          letter-spacing: 0.16em;
          text-transform: uppercase;
          min-width: 3rem;
          height: 3rem;
          padding: 0 var(--space-4);
          cursor: pointer;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          transition: color var(--dur-med) ease;
        }
        .car-arrow::after {
          content: '';
          position: absolute;
          inset: 3px;
          border: 1px solid var(--line);
          pointer-events: none;
          transition: border-color var(--dur-med) ease;
        }
        .car-arrow::before {
          content: '';
          position: absolute;
          inset: 0;
          z-index: -1;
          background: var(--acc-blue);
          transform: scaleX(0);
          transform-origin: center;
          transition: transform var(--dur-med) ease;
        }
        .car-arrow:hover {
          color: var(--ink);
        }
        .car-arrow:hover::before {
          transform: scaleX(1);
        }
        .car-arrow:hover::after {
          border-color: var(--ink);
        }
        .car-arrow:disabled {
          opacity: 0.45;
          cursor: default;
          color: var(--muted);
        }
        .car-arrow:disabled::before {
          transform: scaleX(0);
        }
        .car-arrow:disabled::after {
          border-color: var(--line);
        }
        .car-hint {
          font-family: var(--font-body);
          font-size: 0.8rem;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: var(--muted);
        }
      </style>

      <h2>Testimonials</h2>
      <p class="testi-sub">
        I leave organisations clearer about what matters. See for yourself.
      </p>

      <div class="carousel" id="testi-carousel">
        <div class="carousel-track" id="testi-track">
          <div class="tcard">
            <p class="q">
              Saielle is an amazing leader. She has brought strong product and
              design skills and perspective to our organization. As a true
              360-degree leader she has been able to listen, lead and
              influence her team, her peers and the broader organization. I
              highly recommend her to elevate product thinking and
              capabilities.
            </p>
            <p class="a">
              <span class="name">
                <a href="https://www.linkedin.com/in/susanstandiford/" target="_blank" rel="noopener noreferrer">Susan Standiford</a>
              </span>
              <span class="role">
                Former CTPO, <a href="https://www.linkedin.com/in/susanstandiford/" target="_blank" rel="noopener noreferrer">IKEA, Stepstone</a>
              </span>
            </p>
          </div>

          <div class="tcard">
            <p class="q">
              Saielle helped a new product team choose the right product
              management tool for their needs. She offered her experience
              generously, asked the right questions, and saved them a lot of
              heartache. I can't thank her enough.
            </p>
            <p class="a">
              <span class="name">
                <a href="https://www.goroadmaps.com/" target="_blank" rel="noopener noreferrer">Bruce McCarthy</a>
              </span>
              <span class="role">
                Co-Author, <a href="https://www.goroadmaps.com/" target="_blank" rel="noopener noreferrer">Product Roadmaps Relaunched</a>
              </span>
            </p>
          </div>

          <div class="tcard">
            <p class="q">
              Saielle has a great talent for listening to problems, quickly
              understanding the situation, and helping others unpack ways to
              get through blockers and to the next phase in decision making.
            </p>
            <p class="a">
              <span class="name">
                <a href="https://www.linkedin.com/in/thedailyem/" target="_blank" rel="noopener noreferrer">Emily Tate</a>
              </span>
              <span class="role">
                VP of Product, <a href="https://www.linkedin.com/in/thedailyem/" target="_blank" rel="noopener noreferrer">Mind the Product</a>
              </span>
            </p>
          </div>

          <div class="tcard">
            <p class="q">
              Saielle has the rare gift of uncovering the "why" in every
              situation. I've watched her do this with stakeholder requests,
              product prioritization, and driving conversations toward the
              outcomes that actually matter.
            </p>
            <p class="a">
              <span class="name">
                <a href="https://www.linkedin.com/in/wesgalliher/" target="_blank" rel="noopener noreferrer">Wes Galliher, PhD.</a>
              </span>
              <span class="role">
                Director of Product Management, <a href="https://www.linkedin.com/in/wesgalliher/" target="_blank" rel="noopener noreferrer">Weave</a>
              </span>
            </p>
          </div>

          <div class="tcard">
            <p class="q">
              Saielle is a design leader with a great mind for product, and
              she's also led product teams. Many of us claim expertise in
              either product or design, but it's the rare person who can speak
              with passion, expertise and curiosity to both. She is that rare
              person.
            </p>
            <p class="a">
              <span class="name">
                <a href="https://www.linkedin.com/in/randysilver/" target="_blank" rel="noopener noreferrer">Randy Silver</a>
              </span>
              <span class="role">
                Co-Host, <a href="https://www.linkedin.com/in/randysilver/" target="_blank" rel="noopener noreferrer">The Product Experience Podcast</a>
              </span>
            </p>
          </div>

          <div class="tcard">
            <p class="q">
              Saielle hired for potential. I was not a profile ticking all the
              boxes, yet she believed I could make the jump from consultancy
              into the in-house world. That's a rare skill in a product
              leader: going beyond boxes and valuing people for what they can
              become, not just what they already are.
            </p>
            <p class="a">
              <span class="name">
                <a href="https://www.linkedin.com/in/alessandracanella/" target="_blank" rel="noopener noreferrer">Alessandra Canella</a>
              </span>
              <span class="role">
                Head of Design, <a href="https://www.linkedin.com/in/alessandracanella/" target="_blank" rel="noopener noreferrer">Mega</a>
              </span>
            </p>
          </div>
        </div>

        <div class="carousel-controls">
          <button class="car-arrow" type="button" id="testi-prev" aria-label="Previous testimonials">‹</button>
          <button class="car-arrow" type="button" id="testi-next" aria-label="Next testimonials">›</button>
          <span class="car-hint">Scroll or use the arrows</span>
        </div>
      </div>
    </section>

    <section class="how-section" aria-label="How it works">
      <style>
        .how-section {
          padding-bottom: clamp(3rem, 6vw, 5rem);
        }
        .how-section h2 {
          font-size: 1.7rem;
          margin-bottom: var(--space-7);
        }
        .how-steps {
          list-style: none;
          margin: 0;
          padding: 0;
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: var(--space-9);
          border-top: 1px solid var(--ink);
        }
        .how-step {
          padding-top: var(--space-4);
        }
        .how-step .num {
          display: block;
          font-family: var(--font-display);
          font-optical-sizing: auto;
          font-style: italic;
          font-size: 2.1rem;
          line-height: 1;
          margin-bottom: var(--space-3);
          color: var(--accent);
          opacity: 0.85;
        }
        .how-step h3 {
          font-size: 1.3rem;
          margin-bottom: var(--space-2);
        }
        .how-step p {
          margin: 0;
          font-size: 0.95rem;
          color: var(--muted);
          line-height: 1.6;
        }
        @media (max-width: 720px) {
          .how-steps {
            grid-template-columns: 1fr;
            gap: var(--space-7);
          }
        }
      </style>
      <h2>How it works</h2>
      <ol class="how-steps">
        <li class="how-step">
          <span class="num">01</span>
          <h3>You write in</h3>
          <p>
            A few lines about what you are working on. No pitch needed, no
            essay.
          </p>
        </li>
        <li class="how-step">
          <span class="num">02</span>
          <h3>We scope it on a call</h3>
          <p>
            A short call to check it is a fit. Then you get a written
            proposal: what we would do, when, and what it costs.
          </p>
        </li>
        <li class="how-step">
          <span class="num">03</span>
          <h3>You get clear direction</h3>
          <p>
            Written notes afterwards: decisions made, next steps, who owns
            what. Clear before, during and after.
          </p>
        </li>
      </ol>
    </section>

    <section class="contact-form-section" id="contact-section" aria-label="Send a message">
      <div class="contact-card">
        <h2>Leave me a note.</h2>
        <p class="form-lede">
          Tell me how I can help. I'd love to know what you're working on.
          I'll tell you how I can help.
        </p>
        <form id="contact-form" novalidate>
          <div class="form-grid">
            <label>
              <span class="form-label">Name</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label>
              <span class="form-label">Email</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
          </div>
          <label>
            <span class="form-label">What's this about?</span>
            <select name="topic">
              <option value="strategic-direction">Strategic direction</option>
              <option value="execution">Execution &amp; transformation</option>
              <option value="fractional">Fractional leadership</option>
              <option value="speaking">Speaking &amp; workshops</option>
              <option value="mentoring">Mentoring</option>
              <option value="other">Something else</option>
            </select>
          </label>
          <label>
            <span class="form-label">Message</span>
            <textarea name="message" rows="3" required></textarea>
          </label>
          {
            TURNSTILE_SITEKEY && (
              <>
                <div
                  class="cf-turnstile"
                  data-sitekey={TURNSTILE_SITEKEY}
                  data-theme="light"
                />
                <script
                  is:inline
                  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                  async
                  defer
                />
              </>
            )
          }
          <button class="btn-plain" type="submit">Send it</button>
          <p class="form-status" id="form-status" role="status"></p>
        </form>
      </div>
    </section>

    <section class="faq-section" aria-label="Common questions">
      <style>
        .faq-section {
          padding-bottom: clamp(3rem, 6vw, 5rem);
        }
        .faq-section h2.faq-title {
          font-size: 1.7rem;
          margin-bottom: var(--space-2);
        }
        .faq-sect-sub {
          margin: 0 0 var(--space-7);
          max-width: 52ch;
          color: var(--muted);
          font-size: 0.98rem;
        }
        .faq-steps {
          border-top: 1px solid var(--ink);
        }
        .faq-item {
          border-bottom: 1px solid var(--line);
        }
        .faq-item summary {
          list-style: none;
          cursor: pointer;
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          gap: var(--space-5);
          padding: var(--space-5) 0;
          font-family: var(--font-display);
          font-optical-sizing: auto;
          font-weight: 500;
          font-size: 1.25rem;
          line-height: 1.25;
          color: var(--ink);
        }
        .faq-item summary::-webkit-details-marker {
          display: none;
        }
        .faq-item summary::after {
          content: '+';
          flex-shrink: 0;
          font-family: var(--font-body);
          font-weight: 600;
          font-size: 1.2rem;
          line-height: 1;
          color: var(--accent);
          transition: transform var(--dur-med) ease;
        }
        .faq-item[open] summary::after {
          content: '–';
        }
        .faq-item[open] summary {
          color: var(--accent);
        }
        .faq-item .faq-body {
          padding: 0 0 var(--space-5);
        }
        .faq-item .faq-body p {
          margin: 0 0 var(--space-3);
          color: var(--muted);
        }
        .faq-item .faq-body p:last-child {
          margin-bottom: 0;
        }
      </style>
      <h2 class="faq-title">Fair questions.</h2>
      <p class="faq-sect-sub">
        Straight answers about rates, sliding scale and how engagements
        actually run. Anything missing: ask me.
      </p>
      <div class="faq faq-steps">
        <details class="faq-item">
          <summary>How does the sliding scale work?</summary>
          <div class="faq-body">
            <p>
              Ask. If cost is the blocker, say so in your note. It counts if
              you pay yourself, if your company is bootstrapped, a charity or
              the public sector, or if the full rate means you won't book.
            </p>
            <p>
              No proof, no essay. I confirm the adjusted rate when we book.
              Reduced slots go fast; if the month is full, we find another
              way.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary>Is fractional leadership a real commitment?</summary>
          <div class="faq-body">
            <p>
              Yes, and that is the point. Fractional work runs on an agreed
              rhythm over months, not days. Quick rescue thoughts are exactly
              what strategy sessions are for; fractional leadership is for
              teams that want direction held steady while they build.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary>Do you speak virtually?</summary>
          <div class="faq-body">
            <p>
              Yes. Remote keynotes and workshops carry the same fee unless
              the format is much shorter. For in-person events, travel and
              accommodation are covered by the organizer.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary>Will you sign an NDA?</summary>
          <div class="faq-body">
            <p>Happily. Send yours, or use mine.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary>Can I hire you full-time?</summary>
          <div class="faq-body">
            <p>
              For the right role, yes. Director level and above. The same
              clarity principle applies: shared understanding of the goal
              before we commit. If that sounds like your team, write me a
              note and tell me what you are trying to accomplish.
            </p>
          </div>
        </details>

        <details class="faq-item">
          <summary>How does payment work?</summary>
          <div class="faq-body">
            <p>
              Invoice and bank transfer, GBP unless we agree otherwise. Terms
              are on every proposal.
            </p>
          </div>
        </details>
      </div>
    </section>
  </section>

  <script>
    const ENDPOINT = 'https://contact-form.intentionaut.workers.dev/contact';
    const form = document.getElementById('contact-form');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const statusEl = document.getElementById('form-status');

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (res.ok) {
          form.reset();
          if (statusEl) statusEl.textContent = result.message || "Thank you; I'll reply soon.";
        } else {
          if (statusEl) statusEl.textContent = result.error || 'Something went wrong; please email me directly.';
        }
      } catch {
        if (statusEl) statusEl.textContent = 'Something went wrong; please email me directly.';
      }
    });

    const track = document.getElementById('testi-track')!;
    const prev = document.getElementById('testi-prev') as HTMLButtonElement | null;
    const next = document.getElementById('testi-next') as HTMLButtonElement | null;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      if (prev) prev.disabled = track.scrollLeft <= 0;
      if (next) next.disabled = track.scrollLeft >= max - 1;
    };

    const step = () => {
      const card = track.querySelector<HTMLElement>('.tcard');
      if (!card) return 0;
      const cardWidth = card.getBoundingClientRect().width + 20;
      return cardWidth * 2;
    };

    next?.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    prev?.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    faqItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        faqItems.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  </script>
</BaseLayout>
