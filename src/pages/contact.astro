---
import '@fontsource-variable/roboto-serif';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { BOOKING_URL } from '../data/links';
import { rates, gbp } from '../data/rates';
import { faqsFor } from '../data/faqs';
import { testimonialsFor } from '../data/testimonials';
import FaqList from '../components/FaqList.astro';


// Edit src/data/testimonials.ts to add one, reorder them, or take one down.
// Nothing on this page needs touching for any of that.
const testimonials = testimonialsFor('contact');
---

<BaseLayout
  title="Contact & rates | Saielle DaSilva"
  description="Work with Saielle DaSilva: advisory, fractional product leadership, speaking and mentoring."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Contact &amp; rates</p>
      <h1>Work with me.</h1>
      <p class="lede">
        Got a product team doing something important, while AI keeps changing
        the rules under you? That gap is where I work. I help teams and
        organisations turn noisy ambition into clear decisions, across
        design, data and AI.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a free call</a>
        <a class="link-arrow" href="#contact-section"><span>Send a message</span></a>
      </div>
    </header>

    <section class="rates-section" aria-label="Which one fits?">
      <h2>Which one fits?</h2>
      <p class="rates-intro">Every option starts with a free preliminary call.</p>
      <div class="rates">
        <a class="rate-row rate-card" href="/strategic-direction/">
          <p class="rate-name">Strategy session</p>
          <p class="rate-price">{gbp(rates.strategySession)} · 90 min</p>
          <p class="rate-desc">
            A sounding board for founders and product leaders: strategy
            reviews, roadmap calls, hiring help, AI reality-checks.
          </p>
          <p class="rate-scale">Sliding scale · Yes</p>
        </a>
        <a class="rate-row rate-card" href="/fractional/">
          <p class="rate-name">Fractional leadership</p>
          <p class="rate-price">{gbp(rates.fractional)} / day</p>
          <p class="rate-desc">
            Part-time head of product for early teams that need direction
            now, before they're ready for a full-time hire.
          </p>
          <p class="rate-shape">One or two days a week, three months and up.</p>
        </a>
        <a class="rate-row rate-card" href="/forward-deployed/">
          <p class="rate-name">Product builder</p>
          <p class="rate-price">{gbp(rates.forwardDeployed)} / day</p>
          <p class="rate-desc">
            Three days a week inside your team, building a working prototype
            in your environment.
          </p>
          <p class="rate-shape">Three days a week, four to twelve weeks.</p>
        </a>
        <a class="rate-row rate-card" href="/keynote-speaker/">
          <p class="rate-name">Speaking &amp; workshops</p>
          <p class="rate-price">{gbp(rates.speaking)} / event</p>
          <p class="rate-desc">
            From conference keynotes to hands-on team sessions about building
            with intention across design, data and AI.
          </p>
          <p class="rate-shape">Keynotes and workshops, per event.</p>
          <p class="rate-scale">Sliding scale · Yes</p>
        </a>
        <a class="rate-row rate-card" href="/mentoring/">
          <p class="rate-name">Mentoring</p>
          <p class="rate-price">Get in touch</p>
          <p class="rate-desc">
            A few slots each month for people finding their footing across
            disciplines. That was my path too.
          </p>
        </a>
      </div>
      <p class="rates-note">
        Placing a fractional or interim product person? The short version for
        advisors and recruiters is <a href="/for-advisors/">over here</a>.
      </p>
    </section>



    {/* What happens, then do it: the steps and the form side by side. */}
    <div class="start-band">
    <section class="how-section" aria-label="How it works">
      <style>
        .how-section {
          padding-bottom: clamp(3rem, 6vw, 5rem);
        }
        .how-section h2 {
          font-size: var(--text-lg);
          margin-bottom: var(--space-7);
        }
        .how-steps {
          list-style: none;
          margin: 0;
          padding: 0;
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: var(--space-9);
          border-top: 1px solid var(--ink);
        }
        .how-step {
          padding-top: var(--space-4);
        }
        .how-step .num {
          display: block;
          font-family: var(--font-display);
          font-optical-sizing: auto;
          font-style: italic;
          font-size: 2.1rem;
          line-height: 1;
          margin-bottom: var(--space-3);
          color: var(--accent);
          opacity: 0.85;
        }
        .how-step h3 {
          font-size: var(--text-md);
          margin-bottom: var(--space-2);
        }
        .how-step p {
          margin: 0;
          font-size: 0.95rem;
          color: var(--muted);
          line-height: 1.6;
        }
        @media (max-width: 720px) {
          .how-steps {
            grid-template-columns: 1fr;
            gap: var(--space-7);
          }
        }
      </style>
      <h2>How it works</h2>
      <ol class="how-steps">
        <li class="how-step">
          <span class="num">01</span>
          <h3>You write in</h3>
          <p>
            A few lines about what you are working on. No pitch needed, no
            essay.
          </p>
        </li>
        <li class="how-step">
          <span class="num">02</span>
          <h3>We scope it on a call</h3>
          <p>
            A short call to check it is a fit. Then you get a written
            proposal: what we would do, when, and what it costs.
          </p>
        </li>
        <li class="how-step">
          <span class="num">03</span>
          <h3>You get clear direction</h3>
          <p>
            Written notes afterwards: decisions made, next steps, who owns
            what. Clear before, during and after.
          </p>
        </li>
      </ol>
    </section>

    <section class="contact-form-section" id="contact-section" aria-label="Send a message">
      <div class="contact-card">
        <h2>Leave me a note.</h2>
        <p class="form-lede">
          Tell me what you're working on, and I'll tell you how I can help.
        </p>
        <ContactForm rows={3} selected="other" booking />
      </div>
    </section>
    </div>

    {/* Hidden entirely when nothing is enabled for this page, rather than
        leaving a heading over an empty carousel. An empty state should mean
        "there are none", and here there being none is a choice. */}
    {testimonials.length > 0 && (
    <section class="testimonials-section" aria-label="Testimonials">
      <style>
        :root {
          --acc-blue: #a9cbd0;
        }
        .testimonials-section {
          padding-bottom: clamp(3rem, 6vw, 5rem);
        }
        .testimonials-section h2 {
          font-size: var(--text-lg);
          margin: 0 0 var(--space-2);
        }
        .testi-sub {
          margin: 0 0 var(--space-7);
          max-width: 52ch;
          font-size: 1.05rem;
          color: var(--muted);
        }
        .carousel {
          position: relative;
        }
        .carousel-track {
          display: grid;
          grid-auto-flow: column;
          grid-auto-columns: 88%;
          gap: var(--space-6);
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          scrollbar-width: none;
          padding: var(--space-1);
        }
        .carousel-track::-webkit-scrollbar {
          display: none;
        }
        @media (min-width: 720px) {
          .carousel-track {
            grid-auto-columns: calc(100% / 2.2 - var(--space-6));
          }
        }
        .tcard {
          position: relative;
          border: 1px solid var(--ink);
          background: var(--paper);
          padding: var(--space-6) var(--space-7);
          display: flex;
          flex-direction: column;
          scroll-snap-align: start;
          /* Grows with the quote; the carousel row stretches every card to the tallest. */
          min-height: 460px;
        }
        .tcard::after {
          content: '';
          position: absolute;
          inset: 3px;
          border: 1px solid var(--slate);
          pointer-events: none;
        }
        .tcard .q {
          font-family: var(--font-display);
          font-optical-sizing: auto;
          font-size: 1.12rem;
          line-height: 1.55;
          margin: 0 0 var(--space-4);
          flex: 1 1 auto;
          min-height: 0;
          display: flex;
          flex-direction: column;
          justify-content: safe center;
        }
        .tcard .a {
          margin: 0;
          flex-shrink: 0;
          min-height: calc(var(--space-9) + var(--space-6));
          display: flex;
          flex-direction: column;
          justify-content: flex-end;
          font-family: var(--font-body);
          font-size: var(--text-sm);
          color: var(--ink);
        }
        .tcard .a .name {
          display: block;
          color: var(--ink);
          font-weight: 600;
          font-size: 0.95rem;
          margin-bottom: 0.15em;
          border-top: 1px solid var(--slate);
          padding-top: var(--space-4);
        }
        .tcard .a .name a {
          color: inherit;
          text-decoration: none;
        }
        .tcard .a .name a:hover,
        .tcard .a .role a:hover {
          text-decoration: underline;
          text-decoration-color: var(--accent);
        }
        .tcard .a .role {
          display: block;
          font-style: italic;
        }
        .tcard .a .role a {
          color: var(--ink);
          text-decoration: none;
        }
        .carousel-controls {
          display: flex;
          align-items: center;
          gap: var(--space-3);
          margin-top: var(--space-6);
        }
        .car-arrow {
          position: relative;
          z-index: 0;
          appearance: none;
          background: var(--paper);
          border: 1px solid var(--ink);
          color: var(--ink);
          font-family: var(--font-body);
          font-size: 0.78rem;
          font-weight: 600;
          letter-spacing: 0.16em;
          text-transform: uppercase;
          min-width: 3rem;
          height: 3rem;
          padding: 0 var(--space-4);
          cursor: pointer;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          transition: color var(--dur-med) ease;
        }
        .car-arrow::after {
          content: '';
          position: absolute;
          inset: 3px;
          border: 1px solid var(--slate);
          pointer-events: none;
          transition: border-color var(--dur-med) ease;
        }
        .car-arrow::before {
          content: '';
          position: absolute;
          inset: 0;
          z-index: -1;
          background: var(--acc-blue);
          transform: scaleX(0);
          transform-origin: center;
          transition: transform var(--dur-med) ease;
        }
        .car-arrow:hover {
          color: var(--ink);
        }
        .car-arrow:hover::before {
          transform: scaleX(1);
        }
        .car-arrow:hover::after {
          border-color: var(--ink);
        }
        .car-arrow:disabled {
          opacity: 0.45;
          cursor: default;
          color: var(--muted);
        }
        .car-arrow:disabled::before {
          transform: scaleX(0);
        }
        .car-arrow:disabled::after {
          border-color: var(--slate);
        }
        .car-hint {
          font-family: var(--font-body);
          font-size: 0.8rem;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: var(--muted);
        }
      </style>

      <h2>Testimonials</h2>
      <p class="testi-sub">
        I leave organisations clearer about what matters. See for yourself.
      </p>

      <div class="carousel" id="testi-carousel">
        <div class="carousel-track" id="testi-track">
          {testimonials.map((t) => (
            <div class="tcard">
              <p class="q">{t.quote}</p>
              <p class="a">
                <span class="name">
                  {t.url ? (
                    <a href={t.url} target="_blank" rel="noopener noreferrer">{t.name}</a>
                  ) : (
                    t.name
                  )}
                </span>
                <span class="role">
                  {t.role},{' '}
                  {t.url ? (
                    <a href={t.url} target="_blank" rel="noopener noreferrer">{t.org}</a>
                  ) : (
                    t.org
                  )}
                </span>
              </p>
            </div>
          ))}
        </div>

        <div class="carousel-controls">
          <button class="car-arrow" type="button" id="testi-prev" aria-label="Previous testimonials">‹</button>
          <button class="car-arrow" type="button" id="testi-next" aria-label="Next testimonials">›</button>
          <span class="car-hint">Scroll or use the arrows</span>
        </div>
      </div>
    </section>
    )}

    <FaqList
      items={faqsFor('contact')}
      sub="Straight answers about rates, sliding scale and how engagements actually run. Anything missing: ask me."
    />
  </section>

  <script>
    // The carousel is left out when no testimonials are enabled; without this
    // guard the script threw and the FAQ below never got its handler.
    const track = document.getElementById('testi-track');
    if (track) {
      const prev = document.getElementById('testi-prev') as HTMLButtonElement | null;
      const next = document.getElementById('testi-next') as HTMLButtonElement | null;

      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        if (prev) prev.disabled = track.scrollLeft <= 0;
        if (next) next.disabled = track.scrollLeft >= max - 1;
      };

      const step = () => {
        const card = track.querySelector<HTMLElement>('.tcard');
        if (!card) return 0;
        const cardWidth = card.getBoundingClientRect().width + 20;
        return cardWidth * 2;
      };

      next?.addEventListener('click', () => {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
      prev?.addEventListener('click', () => {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });

      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    faqItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        faqItems.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .start-band {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-10);
    align-items: start;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .start-band .how-section {
    padding-bottom: 0;
  }
  .start-band .how-steps {
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  /* The card starts level with the rule under "How it works": the heading's
     height (one line of --text-lg at line-height 1.08) plus its margin. */
  .start-band .contact-form-section {
    max-width: none;
    margin: calc(var(--text-lg) * 1.08 + var(--space-7)) 0 0;
    /* The band carries the section gap; don't add the form's own on top. */
    padding-bottom: 0;
  }
  @media (max-width: 900px) {
    .start-band {
      grid-template-columns: 1fr;
      gap: var(--space-9);
    }
    .start-band .contact-form-section {
      margin-top: 0;
    }
  }
</style>
