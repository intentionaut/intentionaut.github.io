---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact & rates — Saielle Dasilva"
  description="Work with Saielle Dasilva: advisory, fractional product leadership, speaking and mentoring."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Contact &amp; rates</p>
      <h1>Work with me.</h1>
      <p class="lede">
        I'm currently open to new engagements — advisory, fractional
        leadership, speaking and mentoring.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href="mailto:hello@intentionaut.com"
          >hello@intentionaut.com</a
        >
        <a
          class="link-arrow"
          href="https://www.linkedin.com/in/intentionaut"
          >Find me on LinkedIn</a
        >
      </div>
    </header>

    <section class="rates-section" aria-label="Ways to work together">
      <h2>Ways to work together</h2>
      <dl class="rates">
        <div class="rate-row">
          <dt>Advisory</dt>
          <dd class="rate-price">On request</dd>
          <dd class="rate-desc">
            A sounding board for founders and product leaders — strategy
            reviews, roadmap calls, hiring help, AI reality-checks.
          </dd>
        </div>
        <div class="rate-row">
          <dt>Fractional leadership</dt>
          <dd class="rate-price">On request</dd>
          <dd class="rate-desc">
            Part-time head-of-product firepower for early teams that need
            direction now, before they're ready for a full-time hire.
          </dd>
        </div>
        <div class="rate-row">
          <dt>Speaking &amp; workshops</dt>
          <dd class="rate-price">Fee on request</dd>
          <dd class="rate-desc">
            From conference keynotes to hands-on team sessions about building
            with intention across design, data and AI.
          </dd>
        </div>
        <div class="rate-row">
          <dt>Mentoring</dt>
          <dd class="rate-price">Free–discounted</dd>
          <dd class="rate-desc">
            A handful of slots each month for people finding their footing
            across disciplines — the path I took.
          </dd>
        </div>
      </dl>
      <p class="contact-note">
        Tell me what you're working on and what's keeping you up at night — I
        reply to every serious note.
      </p>
    </section>
  </section>
</BaseLayout>
