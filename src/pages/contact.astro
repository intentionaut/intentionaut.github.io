---
import '@fontsource-variable/roboto-serif';
import BaseLayout from '../layouts/BaseLayout.astro';

// Cloudflare Turnstile sitekey (dash.cloudflare.com, Turnstile)
const TURNSTILE_SITEKEY = '0x4AAAAAAEcCwzuExy2fSCmH';
---

<BaseLayout
  title="Contact & rates | Saielle DaSilva"
  description="Work with Saielle DaSilva: advisory, fractional product leadership, speaking and mentoring."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Contact &amp; rates</p>
      <h1>Work with me.</h1>
      <p class="lede">
        I'm currently open to new engagements: advisory, fractional
        leadership, speaking and mentoring.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href="mailto:hello@intentionaut.com">Email me</a>
        <a
          class="link-arrow"
          href="https://www.linkedin.com/in/intentionaut"
          target="_blank"
          rel="noopener noreferrer"
          >Find me on LinkedIn</a
        >
      </div>
    </header>

    <section class="rates-section" aria-label="Ways to work together">
      <h2>Ways to work together</h2>
      <dl class="rates">
        <a class="rate-row rate-card" href="/strategic-direction/">
          <dt>Strategy session</dt>
          <dd class="rate-price">£400 · 90 min</dd>
          <dd class="rate-desc">
            A sounding board for founders and product leaders: strategy
            reviews, roadmap calls, hiring help, AI reality-checks.
          </dd>
          <dd class="rate-scale">Sliding scale · Yes</dd>
        </a>
        <a class="rate-row rate-card" href="/fractional/">
          <dt>Fractional leadership</dt>
          <dd class="rate-price">£1,400 / day</dd>
          <dd class="rate-desc">
            Part-time head of product for early teams that need direction
            now, before they're ready for a full-time hire.
          </dd>
        </a>
        <a class="rate-row rate-card" href="/execution/">
          <dt>Speaking &amp; workshops</dt>
          <dd class="rate-price">£1,400 / event</dd>
          <dd class="rate-desc">
            From conference keynotes to hands-on team sessions about building
            with intention across design, data and AI.
          </dd>
          <dd class="rate-scale">Sliding scale · Yes</dd>
        </a>
        <div class="rate-row">
          <dt>Mentoring</dt>
          <dd class="rate-price">Get in touch</dd>
          <dd class="rate-desc">
            A few slots each month for people finding their footing across
            disciplines. That was my path too.
          </dd>
        </div>
      </dl>
    </section>

    <section class="contact-form-section" aria-label="Send a message">
      <div class="contact-card">
        <h2>Leave me a note.</h2>
        <p class="form-lede">
          Tell me what you're working on and what's keeping you up at night.
          I make time to reply to everyone who takes the time to share a
          thought or kind word.
        </p>
        <form id="contact-form" novalidate>
          <div class="form-grid">
            <label>
              <span class="form-label">Name</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label>
              <span class="form-label">Email</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
          </div>
          <label>
            <span class="form-label">What's this about?</span>
            <select name="topic">
              <option>Advisory</option>
              <option>Fractional leadership</option>
              <option>Speaking &amp; workshops</option>
              <option>Mentoring</option>
              <option>Something else</option>
            </select>
          </label>
          <label>
            <span class="form-label">Message</span>
            <textarea name="message" rows="5" required></textarea>
          </label>
          {
            TURNSTILE_SITEKEY && (
              <>
                <div
                  class="cf-turnstile"
                  data-sitekey={TURNSTILE_SITEKEY}
                  data-theme="light"
                />
                <script
                  is:inline
                  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                  async
                  defer
                />
              </>
            )
          }
          <button class="btn-plain" type="submit">Send it</button>
          <p class="form-status" id="form-status" role="status"></p>
        </form>
      </div>
      <p class="faq-link">
        Questions first? <a href="/faq">Read the FAQ.</a>
      </p>
    </section>
  </section>

  <script>
    const ENDPOINT = 'https://formspree.io/f/TODO';
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const statusEl = document.getElementById('form-status');

      if (ENDPOINT.includes('TODO')) {
        const body = encodeURIComponent(
          `${data.message}\n\n- ${data.name} (${data.email})\nTopic: ${data.topic}`
        );
        window.location.href = `mailto:hello@intentionaut.com?subject=${encodeURIComponent(
          `[intentionaut.com] ${data.topic}`
        )}&body=${body}`;
        return;
      }

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          form.reset();
          if (statusEl) statusEl.textContent = "Thank you; I'll reply soon.";
        } else {
          if (statusEl) statusEl.textContent = 'Something went wrong; please email me directly.';
        }
      } catch {
        if (statusEl) statusEl.textContent = 'Something went wrong; please email me directly.';
      }
    });
  </script>
</BaseLayout>
