---
import { existsSync } from 'node:fs';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/case-studies.css';

export async function getStaticPaths() {
  const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
  // A locked study's text lives only in its ciphertext. These two checks fail
  // the build, so a readable body can never ship on a locked page and a locked
  // page can never ship without its ciphertext.
  for (const s of studies.filter((s) => s.data.locked)) {
    if (s.body?.trim()) {
      throw new Error(`case study "${s.id}" is locked but its .md has a body. Locked text belongs only in the ciphertext.`);
    }
    if (!existsSync(`public/case-studies/${s.id}/locked.json`)) {
      throw new Error(`case study "${s.id}" is locked but public/case-studies/${s.id}/locked.json is missing.`);
    }
  }
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { locked } = study.data;
const { Content } = await render(study);
---

<BaseLayout title={`${study.data.title} | Saielle DaSilva`} description={study.data.summary} noindex={locked}>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Case study · {study.data.company}</p>
      <h1>{study.data.title}</h1>
      <p class="lede">{study.data.summary}</p>
    </header>

    <div class="case-meta">
      <dl>
        <dt class="meta-label">Role</dt>
        <dd class="meta-value">{study.data.role}</dd>
      </dl>
      <dl>
        <dt class="meta-label">When</dt>
        <dd class="meta-value">{study.data.years}</dd>
      </dl>
      <div class="case-meta-cta">
        <a class="link-arrow link-arrow--back" href="/case-studies/">All case studies</a>
      </div>
    </div>

    {
      locked ? (
        <div class="cs-lock" data-lock={`/case-studies/${study.id}/locked.json`} data-slug={study.id}>
          <p class="cs-lock-note" role="status" aria-live="polite">
            This case study is private. Open it from the link you were sent, or <a href="/contact/">ask me for one</a>.
          </p>
          <article class="prose cs-prose" hidden />
        </div>
      ) : (
        <article class="prose cs-prose">
          <Content />
        </article>
      )
    }
  </section>
</BaseLayout>

<script>
  import { forgetKey, keyFromLink, saveKey, savedKey, unlock } from '../../lib/case-lock.js';

  const box = document.querySelector<HTMLElement>('.cs-lock');
  if (box) {
    const note = box.querySelector('.cs-lock-note')!;
    const article = box.querySelector('article')!;

    const open = async () => {
      const key = keyFromLink(location.hash) ?? savedKey();
      if (!key) return;
      try {
        const res = await fetch(box.dataset.lock!);
        if (!res.ok) throw new Error(String(res.status));
        article.innerHTML = await unlock(await res.json(), key);
        article.hidden = false;
        note.hidden = true;
        saveKey(key);
      } catch {
        forgetKey();
        article.hidden = true;
        note.hidden = false;
        note.textContent = "This link no longer opens the case study. Ask me for a new one.";
      }
    };
    open();
    // A link pasted while already on the page only changes the hash, which
    // doesn't reload it.
    window.addEventListener('hashchange', open);
  }
</script>
