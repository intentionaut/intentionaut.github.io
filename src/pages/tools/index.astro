---
import Plate from '../../components/Plate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { families, toolHref } from '../../data/tools';
---

<BaseLayout
  title="Free tools for product and AI teams | Saielle DaSilva"
  description="Free, printable tools from Saielle DaSilva to run with your team, starting with Impact First AI: the FIRST AI Maturity Model and the Impact Chain. CC BY 4.0."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Tools</p>
      <h1>Free tools to run with your team.</h1>
      <p class="lede">
        Print them, fill them in together, adapt them. Every tool here is free
        to share under CC BY 4.0.
      </p>
    </header>

    {families.map((f) => (
      <section class="rates-section" id={f.slug} aria-labelledby={`${f.slug}-h`}>
        <h2 id={`${f.slug}-h`}>{f.name}</h2>
        <p class="prose">{f.card}</p>
        <div class="rates">
          {f.tools.map((t, i) => (
            <a class="rate-row rate-card envelope" href={toolHref(f, t)}>
              <Plate name={t.icon} tone={i % 2 ? 'blue' : 'pink'} />
              <p class="eyebrow">{t.question}</p>
              <p class="rate-name">{t.title}</p>
              <p class="rate-desc">{t.expand && <><span class="expand">{t.expand.map((w, k) => <>{k > 0 && ', '}<strong>{w[0]}</strong>{w.slice(1)}</>)}.</span>{' '}</>}{t.card}</p>
              <p class="rate-shape">{t.pages}, free.</p>
            </a>
          ))}
        </div>
        <p><a class="link-arrow" href={`/tools/${f.slug}/`}><span>About {f.name}</span></a></p>
      </section>
    ))}
  </section>
</BaseLayout>
