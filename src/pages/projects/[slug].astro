---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const host = project.data.url ? new URL(project.data.url).hostname : null;
const repoHost = project.data.repoUrl ? new URL(project.data.repoUrl).hostname : null;
---

<BaseLayout
  title={`${project.data.title} | Saielle DaSilva`}
  description={project.data.summary}
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>{project.data.title}</h1>
      <p class="lede">{project.data.summary}</p>
    </header>

    <div class="case-meta">
      <dl>
        <dt class="meta-label">Role</dt>
        <dd class="meta-value">{project.data.role}</dd>
      </dl>
      {
        project.data.timeline && (
          <dl>
            <dt class="meta-label">Timeline</dt>
            <dd class="meta-value">{project.data.timeline}</dd>
          </dl>
        )
      }
      {
        project.data.status && (
          <dl>
            <dt class="meta-label">Status</dt>
            <dd class="meta-value">{project.data.status}</dd>
          </dl>
        )
      }
      {
        project.data.url && (
          <dl>
            <dt class="meta-label">Link</dt>
            <dd class="meta-value">
              <a href={project.data.url} target="_blank" rel="noopener noreferrer">
                {project.data.linkLabel ?? host}
              </a>
            </dd>
          </dl>
        )
      }
      {
        project.data.repoUrl && (
          <dl>
            <dt class="meta-label">Source</dt>
            <dd class="meta-value">
              <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">
                {project.data.repoLabel ?? repoHost}
              </a>
            </dd>
          </dl>
        )
      }
      <div class="case-meta-cta">
        <a class="link-arrow link-arrow--back" href="/projects/">All projects</a>
      </div>
    </div>

    <article class="prose">
      <Content />
    </article>

    <div class="cta-row project-cta">
      {
        project.data.url && (
          <a class="btn-primary" href={project.data.url} target="_blank" rel="noopener noreferrer">
            {project.data.ctaLabel ?? `Visit ${host}`}
          </a>
        )
      }
      {
        project.data.repoUrl && (
          <a class="link-arrow" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">
            {project.data.repoLabel ?? "View the source"}
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>
