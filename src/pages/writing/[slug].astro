---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrameSubscribe from '../../components/FrameSubscribe.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import KeepReading from '../../components/KeepReading.astro';
import { relatedFor } from '../../lib/archive';
import { getCollection, render } from 'astro:content';
import { fetchPosts, hasWebBody } from '../../lib/beehiiv';
import { trimDescription } from '../../lib/meta-description.mjs';

export async function getStaticPaths() {
  const [posts, essays] = await Promise.all([
    fetchPosts(),
    getCollection('essays'),
  ]);

  // A gated post has no body to show, so it gets no page at all rather than a
  // blank one. See hasWebBody.
  const beehiivPaths = posts.filter(hasWebBody).map((post) => ({
    params: { slug: post.slug },
    props: { type: 'beehiiv', post },
  }));

  const essayPaths = essays.map((essay) => ({
    params: { slug: essay.id },
    props: { type: 'essay', essay },
  }));

  return [...beehiivPaths, ...essayPaths];
}

const { type, post, essay } = Astro.props;

let essayContent: Awaited<ReturnType<typeof render>> | null = null;
if (type === 'essay' && essay) {
  essayContent = await render(essay);
}

const fmtDate = (d: string | number) =>
  new Date(d).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    // Pin to UTC so the rendered day matches the schema's ISO date on any
    // build machine (a backdated beehiiv post stored near midnight was
    // rolling to the next day in local time).
    timeZone: 'UTC',
  });

const origin = Astro.site!.origin;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const related = await relatedFor(Astro.url.pathname);

// Search descriptions for beehiiv posts whose subtitle reads poorly as one.
// Meta only: the subtitle in beehiiv, email and on the page is unchanged.
const DESCRIPTION_OVERRIDES: Record<string, string> = {
  'building-ai-that-actually-helps':
    "Why AI is getting human again: the features that make a day easier, a decision clearer, and what product teams should build next.",
  'execution-vs-data-moats':
    "Proprietary data used to be the moat. Now APIs and general models match it. Why speed and execution now decide who wins with AI.",
  'impact-cant-bypass-politics':
    "A team shipping well still lost the room. How a feature and an outcome got folded into one, and how to reopen the conversation.",
  'leading-data-transformation-in-the-age-of-ai':
    "AI needs data that flows differently. The human factors, stewardship and team habits that turn a data strategy into changed decisions.",
  'the-ai-agent-reality-check':
    "Enterprise AI agents will fail on workflows, not models. Three anti-patterns, starting with agent washing, and how to avoid them.",
  'the-ai-opportunity-you-re-missing':
    "From my ProductTank Oxford talk: 42% of companies scrapped most AI work in 2025. Where real user needs meet reliable AI.",
  'the-enterprise-guide-to-ai-economics':
    "Why AI budgets spiral when last year's estimates meet this year's projects, and how product leaders can budget AI work sustainably.",
  'the-new-architecture-of-software-quality':
    "Uptime and bug counts can't measure AI. A new quality framework for software that has to handle ambiguity, context and emergence.",
};

// "A personal note" keeps its full subtitle, at Elle's request.
const postDescription = post
  ? DESCRIPTION_OVERRIDES[post.slug] ??
    (post.slug === 'a-personal-note'
    ? post.subtitle || post.title
    : trimDescription(post.subtitle || post.title))
  : '';

const essayDescription = essay
  ? essay.id === 'a-personal-note'
    ? essay.data.description
    : trimDescription(essay.data.description)
  : '';

const meta =
  type === 'beehiiv' && post
    ? {
        headline: post.title,
        description: postDescription,
        published: new Date(post.publish_date * 1000).toISOString(),
        image: post.thumbnail_url || `${origin}/og.png`,
      }
    : type === 'essay' && essay
      ? {
          headline: essay.data.title,
          description: essayDescription,
          published: essay.data.date.toISOString(),
          image: `${origin}/og.png`,
        }
      : null;

const articleLd = meta
  ? [
      {
        '@type': 'BlogPosting',
        '@id': `${canonical}#article`,
        headline: meta.headline,
        description: meta.description,
        datePublished: meta.published,
        dateModified: meta.published,
        image: meta.image,
        author: { '@id': `${origin}/#person` },
        publisher: { '@id': `${origin}/#organization` },
        mainEntityOfPage: { '@id': `${canonical}#webpage` },
        isPartOf: { '@id': `${origin}/#website` },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Writing',
            item: `${origin}/writing/`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: meta.headline,
            item: canonical,
          },
        ],
      },
    ]
  : undefined;
---

{type === 'beehiiv' && post && (
  <BaseLayout
    title={`${post.title} | Saielle DaSilva`}
    description={postDescription}
    ogType="article"
    ogImage={`/share/${Astro.params.slug}.png`}
    publishedTime={meta?.published}
    jsonLd={articleLd}
  >
    <article class="wrap">
      <header class="page-head">
        <p class="eyebrow">Intentionaut</p>
        <h1>{post.title}</h1>
        {post.subtitle && (
          <div class="flap">
            <p class="flap-label">In this piece</p>
            <p class="lede">{post.subtitle}</p>
          </div>
        )}
        <p class="article-meta">
          {fmtDate(post.publish_date * 1000)} · {post.authors.join(', ')}
        </p>
      </header>

      <div class="prose article-body" set:html={post.content_html} />

      <AuthorBio />

      <section class="article-cta" aria-label="Subscribe">
        <FrameSubscribe
          heading={`If “${post.title}” was useful, the next one will be too.`}
          sub="How leaders set direction when AI does more of the building. Field-tested with the receipts."
          source="article"
          campaign={post.slug}
          emailId="article-email"
          buttonLabel="Get the next one"
          align="left"
        />
      </section>

      <KeepReading items={related} />

      <section class="article-footer">
        <a class="link-arrow" href="/writing/"><span>Back to all writing</span></a>
      </section>
    </article>
  </BaseLayout>
)}

{type === 'essay' && essay && essayContent && (
  <BaseLayout
    title={`${essay.data.title} | Saielle DaSilva`}
    description={essayDescription}
    ogType="article"
    ogImage={`/share/${Astro.params.slug}.png`}
    publishedTime={meta?.published}
    jsonLd={articleLd}
  >
    <article class="wrap">
      <header class="page-head">
        <p class="eyebrow">{essay.data.source}</p>
        <h1>{essay.data.title}</h1>
        <div class="flap">
          <p class="flap-label">In this piece</p>
          <p class="lede">{essay.data.description}</p>
        </div>
        <p class="article-meta">{fmtDate(essay.data.date.toString())}</p>
      </header>

      <div class="prose article-body">
        <essayContent.Content />
      </div>

      <AuthorBio />

      <section class="article-cta" aria-label="Subscribe">
        <FrameSubscribe
          heading={`If “${essay.data.title}” was useful, the next one will be too.`}
          sub="How leaders set direction when AI does more of the building. Field-tested with the receipts."
          source="essay"
          campaign={essay.id}
          emailId="essay-email"
          buttonLabel="Get the next one"
          align="left"
        />
      </section>

      <KeepReading items={related} />

      <section class="article-footer">
        {essay.data.originalUrl && (
          <p class="article-original">
            Originally published in {essay.data.source}.{' '}
            <a
              href={essay.data.originalUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              View original
            </a>
          </p>
        )}
        <a class="link-arrow" href="/writing/"><span>Back to all writing</span></a>
      </section>
    </article>
  </BaseLayout>
)}

<style>
  /* Jacket flap: the standfirst behind a double rule, like a book's inside flap. */
  .flap {
    border-left: 3px double var(--ink);
    padding: var(--space-1) 0 var(--space-1) var(--space-4);
    margin-top: var(--space-4);
    max-width: 62ch;
  }
  .flap-label {
    margin: 0 0 var(--space-1);
    font: 500 0.66rem var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .flap .lede {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
  }
  .article-meta {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* The close of an essay, in bands (design system, Layout): the sign-up
     card and the footer each sit one section gap below the block before;
     the footer's rule takes that gap, then --space-7 inside, and the page
     ends on the section gap. */
  .article-cta {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .article-footer {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: var(--space-7);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--slate);
  }

  .article-original {
    margin-bottom: var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
