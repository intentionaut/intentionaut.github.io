---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchPosts } from '../../lib/beehiiv';

export async function getStaticPaths() {
  const posts = await fetchPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const fmtDate = new Date(post.publish_date * 1000).toLocaleDateString(
  'en-US',
  { month: 'long', day: 'numeric', year: 'numeric' }
);
---

<BaseLayout
  title={`${post.title} | Saielle DaSilva`}
  description={post.subtitle || post.title}
>
  <article class="wrap">
    <header class="page-head">
      <p class="eyebrow">The Second Draft</p>
      <h1>{post.title}</h1>
      {post.subtitle && <p class="lede">{post.subtitle}</p>}
      <p class="article-meta">
        {fmtDate} · {post.authors.join(', ')}
      </p>
    </header>

    <div class="prose article-body" set:html={post.content_html} />

    <section class="article-footer">
      <a class="link-arrow" href="/writing"><span>Back to all writing</span></a>
    </section>
  </article>
</BaseLayout>

<style>
  .article-meta {
    margin-top: var(--space-3);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .article-footer {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
  }
</style>
