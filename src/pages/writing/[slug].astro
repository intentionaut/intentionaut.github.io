---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import KeepReading from '../../components/KeepReading.astro';
import { relatedTo } from '../../data/writing';
import { getCollection, render } from 'astro:content';
import { fetchPosts } from '../../lib/beehiiv';

export async function getStaticPaths() {
  const [posts, essays] = await Promise.all([
    fetchPosts(),
    getCollection('essays'),
  ]);

  const beehiivPaths = posts.map((post) => ({
    params: { slug: post.slug },
    props: { type: 'beehiiv', post },
  }));

  const essayPaths = essays.map((essay) => ({
    params: { slug: essay.id },
    props: { type: 'essay', essay },
  }));

  return [...beehiivPaths, ...essayPaths];
}

const { type, post, essay } = Astro.props;

let essayContent: Awaited<ReturnType<typeof render>> | null = null;
if (type === 'essay' && essay) {
  essayContent = await render(essay);
}

const fmtDate = (d: string | number) =>
  new Date(d).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    // Pin to UTC so the rendered day matches the schema's ISO date on any
    // build machine (a backdated beehiiv post stored near midnight was
    // rolling to the next day in local time).
    timeZone: 'UTC',
  });

const origin = Astro.site!.origin;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const related = relatedTo(Astro.url.pathname);

const meta =
  type === 'beehiiv' && post
    ? {
        headline: post.title,
        description: post.subtitle || post.title,
        published: new Date(post.publish_date * 1000).toISOString(),
        image: post.thumbnail_url || `${origin}/og.png`,
      }
    : type === 'essay' && essay
      ? {
          headline: essay.data.title,
          description: essay.data.description,
          published: essay.data.date.toISOString(),
          image: `${origin}/og.png`,
        }
      : null;

const articleLd = meta
  ? [
      {
        '@type': 'BlogPosting',
        '@id': `${canonical}#article`,
        headline: meta.headline,
        description: meta.description,
        datePublished: meta.published,
        dateModified: meta.published,
        image: meta.image,
        author: { '@id': `${origin}/#person` },
        publisher: { '@id': `${origin}/#organization` },
        mainEntityOfPage: { '@id': `${canonical}#webpage` },
        isPartOf: { '@id': `${origin}/#website` },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Writing',
            item: `${origin}/writing/`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: meta.headline,
            item: canonical,
          },
        ],
      },
    ]
  : undefined;
---

{type === 'beehiiv' && post && (
  <BaseLayout
    title={`${post.title} | Saielle DaSilva`}
    description={post.subtitle || post.title}
    ogType="article"
    publishedTime={meta?.published}
    jsonLd={articleLd}
  >
    <article class="wrap">
      <header class="page-head">
        <p class="eyebrow">Intentionaut</p>
        <h1>{post.title}</h1>
        {post.subtitle && <p class="lede">{post.subtitle}</p>}
        <p class="article-meta">
          {fmtDate(post.publish_date * 1000)} · {post.authors.join(', ')}
        </p>
      </header>

      <div class="prose article-body" set:html={post.content_html} />

      <AuthorBio />

      <section class="signup article-cta" aria-label="Subscribe">
        <h2>If &ldquo;{post.title}&rdquo; was useful, the next one will be too.</h2>
        <p class="signup-sub">
          Fortnightly essays on design, product, data and AI. The list gets them
          first. No spam, unsubscribe anytime.
        </p>
        <SubscribeForm
          source="article"
          campaign={post.slug}
          emailId="article-email"
          buttonLabel="Get the next one"
        />
      </section>

      <KeepReading items={related} />

      <section class="article-footer">
        <a class="link-arrow" href="/writing/"><span>Back to all writing</span></a>
      </section>
    </article>
  </BaseLayout>
)}

{type === 'essay' && essay && essayContent && (
  <BaseLayout
    title={`${essay.data.title} | Saielle DaSilva`}
    description={essay.data.description}
    ogType="article"
    publishedTime={meta?.published}
    jsonLd={articleLd}
  >
    <article class="wrap">
      <header class="page-head">
        <p class="eyebrow">{essay.data.source}</p>
        <h1>{essay.data.title}</h1>
        <p class="article-meta">{fmtDate(essay.data.date.toString())}</p>
      </header>

      <div class="prose article-body">
        <essayContent.Content />
      </div>

      <AuthorBio />

      <section class="signup article-cta" aria-label="Subscribe">
        <h2>If &ldquo;{essay.data.title}&rdquo; was useful, the next one will be too.</h2>
        <p class="signup-sub">
          Fortnightly essays on design, product, data and AI. The list gets them
          first. No spam, unsubscribe anytime.
        </p>
        <SubscribeForm
          source="essay"
          campaign={essay.id}
          emailId="essay-email"
          buttonLabel="Get the next one"
        />
      </section>

      <KeepReading items={related} />

      <section class="article-footer">
        {essay.data.originalUrl && (
          <p class="article-original">
            Originally published in {essay.data.source}.{' '}
            <a
              href={essay.data.originalUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              View original
            </a>
          </p>
        )}
        <a class="link-arrow" href="/writing/"><span>Back to all writing</span></a>
      </section>
    </article>
  </BaseLayout>
)}

<style>
  .article-meta {
    margin-top: var(--space-3);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .article-footer {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--slate);
  }

  .article-original {
    margin-bottom: var(--space-4);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
