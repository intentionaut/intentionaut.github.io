---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getCollection('pages')).find((p) => p.id === 'about');
if (!entry) throw new Error('About page content is missing (src/content/pages/about.md)');
const { Content } = await render(entry);

const arc = [
  {
    org: "Sainsbury's",
    role: 'Senior Head of Product – AI, Data Platforms, & Machine Learning',
    note: 'Production AI taken from a handful of experiments to a platform serving millions of customers.',
  },
  {
    org: 'Direct-to-consumer grocery scaleup',
    role: 'Interim CPO',
    note: '+450% MRR in 90 days.',
  },
  {
    org: 'StepStone',
    role: 'Global VP of Experience Design',
    note: 'Some of the earliest LLM-powered products in European recruitment; a 3.2x ROI improvement across the satellite product portfolio.',
  },
  {
    org: 'Cazoo',
    role: 'Founding team',
    note: "The UK's first fully digital car-buying experience; through hyper-growth to a $7B IPO.",
  },
  {
    org: 'Pivotal, Dallas',
    role: 'Founding hire',
    note: 'Helped companies turn practices into products.',
  },
  {
    org: 'Amazon & AT&T',
    role: 'Early chapters',
    note: 'How very large organisations actually move.',
  },
];

const stats = [
  { num: '$7B', label: 'IPO valuation' },
  { num: '100M+', label: 'Customers served' },
  { num: '£165M+', label: 'Savings delivered' },
  { num: '26', label: 'Global job markets' },
];
---

<BaseLayout
  title={entry.data.seoTitle ?? `${entry.data.title} | Saielle DaSilva`}
  description={entry.data.description}
  profilePage
>
  <section class="wrap">
    <header class="page-head long-title">
      <div class="page-head-intro">
        <div class="page-head-text">
          <p class="eyebrow">About</p>
          <h1>{entry.data.title}</h1>
        </div>
        <figure class="portrait">
          <div class="img-card">
            <img
              src="/saielle-dasilva.jpg"
              alt="Saielle DaSilva"
              width="360"
              height="480"
            />
          </div>
          <figcaption class="img-caption">Saielle DaSilva</figcaption>
        </figure>
      </div>
      <p class="lede stat-lede">Some career highlights.</p>
      <ul class="stat-strip" aria-label="Track record in numbers">
        {
          stats.map((s) => (
            <li>
              <span class="stat-num">{s.num}</span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="prose about-intro">
      <p>
        I started in design. Along the way, I discovered a passion for data.
        The discipline of informing decisions with real evidence and
        measuring real impact became a foundation of my work style.
      </p>
      <p>
        Good software takes more than good people. I have been on teams full of
        talent that still shipped the wrong thing, carefully. What was missing
        was never skill. It was agreement about what we were building and why.
      </p>
      <blockquote>
        <p>
          in·ten·tion·aut <em>(n.)</em>: A navigator of intention; one who
          journeys through complexity with a clear sense of what matters and
          why.
        </p>
      </blockquote>
      <p>
        The word is invented, but intention captures the arc of my work.
      </p>
    </div>

    <div class="prose about-final">
      <Content />
    </div>

    <section class="arc-section" aria-label="Career arc">
      <h2>A brief history.</h2>
      <ol class="talk-list arc-list">
        {
          arc.map((a) => (
            <li class="talk-row">
              <span class="talk-date">{a.org}</span>
              <div>
                <span class="talk-title">{a.role}</span>
                <p class="talk-desc">{a.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </section>
</BaseLayout>

<style>
  /* The header is binary: the headline and portrait sit side by side, each
     taking half the row (50/50), flush to the content edge and vertically
     centred so they read as a pair. Everything else - the "career highlights"
     line, the stat ribbon, the prose - is full width below. Below the tablet
     width (40rem) the portrait is hidden entirely, leaving just the headline. */
  .page-head-intro {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    align-items: center;
  }

  .page-head-intro .portrait {
    margin: 0;
  }

  /* "Some career highlights." labels the stat ribbon: tight above the ribbon,
     the breathing room placed above the line. clamp(2rem, 4vw, 3rem) is the
     system's small section gap (--space-3 below matches the ribbon's own
     row padding). */
  .stat-lede {
    margin: clamp(2rem, 4vw, 3rem) 0 var(--space-3);
  }

  .page-head-intro ~ .stat-strip {
    margin-top: 0;
  }

  /* Break the body into three with hairline keylines (1px var(--slate), the
     site's rule): narrative, "How I work", the ledger. Each line sits roughly
     centred in its gap - margin-top is a step smaller than padding-top to
     offset the ~1.5rem trailing margin of the paragraph above it, and
     .about-final drops its own bottom padding so that offset is predictable.
     The ledger break is one step larger than "How I work". All values are
     system fluid steps. The "How I work" keyline runs to the prose measure
     (its <h2> lives inside .prose, hence :global); the ledger keyline runs the
     full content width, matching the ledger. */
  .about-final {
    padding-bottom: 0;
  }

  .about-final :global(h2) {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--slate);
  }

  .arc-section {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--slate);
  }

  /* Below the tablet width the headshot costs more vertical space than it earns,
     so hide it entirely; the Person schema still carries the image. The
     threshold (40rem) sits below the smallest iPad (768px = 48rem), so every
     tablet keeps the 50/50 split and only phones drop the photo. */
  @media (max-width: 40rem) {
    .page-head-intro {
      grid-template-columns: 1fr;
    }

    .page-head-intro .portrait {
      display: none;
    }
  }
</style>
