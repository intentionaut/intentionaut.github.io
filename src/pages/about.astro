---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getCollection('pages')).find((p) => p.id === 'about');
if (!entry) throw new Error('About page content is missing (src/content/pages/about.md)');
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Saielle DaSilva`} description={entry.data.description}>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1>{entry.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <aside class="proof" aria-label="Experience and speaking">
      <p>Product leadership for Sainsbury's · Cazoo · StepStone · Pivotal · Amazon · AT&amp;T</p>
      <p>Speaker — Mind the Product · Turing Fest · Business of Software</p>
    </aside>
  </section>
</BaseLayout>
