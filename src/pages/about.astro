---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getCollection('pages')).find((p) => p.id === 'about');
if (!entry) throw new Error('About page content is missing (src/content/pages/about.md)');
const { Content } = await render(entry);

const arc = [
  {
    org: "Sainsbury's",
    role: 'Senior Head of Product – AI, Data Platforms, & Machine Learning',
    note: 'Production AI taken from a handful of experiments to a platform serving millions of customers.',
  },
  {
    org: 'StepStone',
    role: 'Global VP of Experience Design',
    note: 'Some of the earliest LLM-powered products in European recruitment; 26 global job markets.',
  },
  {
    org: 'Cazoo',
    role: 'Founding team',
    note: "The UK's first fully digital car-buying experience; through hyper-growth to a $7B IPO.",
  },
  {
    org: 'Pivotal, Dallas',
    role: 'Founding hire',
    note: 'Helped companies turn practices into products.',
  },
  {
    org: 'Amazon & AT&T',
    role: 'Early chapters',
    note: 'How very large organisations actually move.',
  },
];

const stats = [
  { num: '$7B', label: 'IPO' },
  { num: '100M+', label: 'Customers across career' },
  { num: '+450%', label: 'MRR in 90 days' },
  { num: '26', label: 'Global job markets' },
];
---

<BaseLayout title={`${entry.data.title} | Saielle DaSilva`} description={entry.data.description}>
  <section class="wrap">
    <header class="page-head long-title">
      <p class="eyebrow">About</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">
        Some career highlights.
      </p>
      <ul class="stat-strip" aria-label="Track record in numbers">
        {
          stats.map((s) => (
            <li>
              <span class="stat-num">{s.num}</span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="prose about-intro">
      <p>
        I started in <strong>design</strong>. Then came the crossings: into
        <strong>product</strong>, into leadership, into enterprise
        <strong>AI</strong>. Along the way I fell for <strong>data</strong>:
        not dashboards for their own sake, but the discipline of letting
        reality vote on our plans.
      </p>
      <blockquote>
        <p>
          in·ten·tion·aut <em>(n.)</em>: one who navigates by intention.
          Chooses direction deliberately, before choosing speed.
        </p>
      </blockquote>
      <p>
        The word is invented, but the instinct is old. Theology trained me to
        ask <em>why</em> before anyone agrees on <em>what</em>. Organising
        volunteers after Hurricane Sandy taught me that organisations behave
        like products; the way people move through them can be designed.
        Every roadmap hides a question: why this, why now, why us. Most
        stalled work traces back to one that never got answered.
      </p>
      <p>
        My job is getting a team to that answer quickly, then keeping it
        honest while it earns its keep: shipped product, experiences
        customers love, results the board can see.
      </p>
    </div>

    <section class="arc-section" aria-label="Career arc">
      <h2>A brief history.</h2>
      <ol class="talk-list arc-list">
        {
          arc.map((a) => (
            <li class="talk-row">
              <span class="talk-date">{a.org}</span>
              <div>
                <span class="talk-title">{a.role}</span>
                <p class="talk-desc">{a.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>
