---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getCollection('pages')).find((p) => p.id === 'about');
if (!entry) throw new Error('About page content is missing (src/content/pages/about.md)');
const { Content } = await render(entry);

const arc = [
  {
    org: "Sainsbury's",
    role: 'Senior Head of Product – AI, Data Platforms, & Machine Learning',
    note: 'Production AI taken from a handful of experiments to a platform serving millions of customers.',
  },
  {
    org: 'PeskyFish',
    role: 'Interim CPO',
    note: '+450% MRR in 90 days.',
  },
  {
    org: 'StepStone',
    role: 'Global VP of Experience Design',
    note: 'Some of the earliest LLM-powered products in European recruitment; a 3.2x ROI improvement across the satellite product portfolio.',
  },
  {
    org: 'Cazoo',
    role: 'Founding team',
    note: "The UK's first fully digital car-buying experience; through hyper-growth to a $7B IPO.",
  },
  {
    org: 'Pivotal, Dallas',
    role: 'Founding hire',
    note: 'Helped companies turn practices into products.',
  },
  {
    org: 'Amazon & AT&T',
    role: 'Early chapters',
    note: 'How very large organisations actually move.',
  },
];

const stats = [
  { num: '$7B', label: 'IPO valuation' },
  { num: '100M+', label: 'Customers served' },
  { num: '£165M+', label: 'Savings unlocked' },
  { num: '26', label: 'Global job markets' },
];
---

<BaseLayout
  title={entry.data.seoTitle ?? `${entry.data.title} | Saielle DaSilva`}
  description={entry.data.description}
  profilePage
>
  <section class="wrap">
    <header class="page-head long-title">
      <div class="page-head-intro">
        <div class="page-head-text">
          <p class="eyebrow">About</p>
          <h1>{entry.data.title}</h1>
        </div>
        <figure class="portrait">
          <div class="portrait-frame">
            <img
              src="/saielle-dasilva.jpg"
              alt="Saielle DaSilva"
              width="360"
              height="480"
            />
          </div>
          <figcaption>Saielle DaSilva</figcaption>
        </figure>
      </div>
      <p class="lede stat-lede">Some career highlights.</p>
      <ul class="stat-strip" aria-label="Track record in numbers">
        {
          stats.map((s) => (
            <li>
              <span class="stat-num">{s.num}</span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="prose about-intro">
      <p>
        I started in design. Along the way, I discovered a passion for data.
        The discipline of informing decisions with real evidence and
        measuring real impact became a foundation of my work style.
      </p>
      <p>
        Good software is made of more than good people. Great people are
        everywhere, but good software is harder to find.
      </p>
      <blockquote>
        <p>
          in·ten·tion·aut <em>(n.)</em>: A navigator of intention; one who
          journeys through complexity with a clear sense of what matters and
          why.
        </p>
      </blockquote>
      <p>
        The word is invented, but intention captures the arc of my work.
      </p>
    </div>

    <div class="prose about-final">
      <Content />
    </div>

    <section class="arc-section" aria-label="Career arc">
      <h2>A brief history.</h2>
      <ol class="talk-list arc-list">
        {
          arc.map((a) => (
            <li class="talk-row">
              <span class="talk-date">{a.org}</span>
              <div>
                <span class="talk-title">{a.role}</span>
                <p class="talk-desc">{a.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </section>
</BaseLayout>

<style>
  /* Eyebrow + headline on the left, portrait on the right, flush to the content
     edge. The headline keeps the whole remaining column so it wraps the way it
     did before (its own max-width in global.css still caps it); the portrait is
     a fixed 15rem beside it, vertically centred so the two read as a pair with
     no gap between them. Everything else - the "career highlights" line, the
     stat ribbon, the prose - is full width below.
     (A `ch` track was tried here and resolved against the grid's body font, not
     the headline's, which crushed the headline to a narrow column.) */
  .page-head-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }

  .page-head-intro .portrait {
    margin: 0;
  }

  /* "Some career highlights." labels the stat ribbon, so it sits tight above
     it, with the breathing room placed above the line instead. */
  .stat-lede {
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 var(--space-3);
  }

  .page-head-intro ~ .stat-strip {
    margin-top: 0;
  }

  /* The body prose sits centred in the page rather than hard left, so its
     column balances between the full-width ribbon above and the arc below.
     Text stays left aligned; only the measure is centred. */
  .about-intro,
  .about-final {
    margin-inline: auto;
  }

  /* Below the point where a 16rem portrait would start crowding the headline,
     stack: text, then portrait, then the (still full-width) stat strip. */
  @media (max-width: 52rem) {
    .page-head-intro {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .page-head-intro .portrait {
      max-width: 14rem;
    }
  }

  /* On phones the headshot costs more vertical space than it earns; the Person
     schema still carries the image. */
  @media (max-width: 45rem) {
    .page-head-intro .portrait {
      display: none;
    }
  }

  .portrait-frame {
    display: block;
    padding: 12px;
    border: 1px solid var(--ink);
    position: relative;
  }

  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--line);
    pointer-events: none;
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Same treatment as .img-caption elsewhere on the site. */
  .portrait figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
  }

</style>
