---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getCollection('pages')).find((p) => p.id === 'about');
if (!entry) throw new Error('About page content is missing (src/content/pages/about.md)');
const { Content } = await render(entry);

const arc = [
  {
    org: "Sainsbury's",
    role: 'Senior Head of Product – AI, Data Platforms, & Machine Learning',
    note: 'Production AI taken from a handful of experiments to a platform serving millions of customers.',
  },
  {
    org: 'PeskyFish',
    role: 'Interim CPO',
    note: '+450% MRR in 90 days.',
  },
  {
    org: 'StepStone',
    role: 'Global VP of Experience Design',
    note: 'Some of the earliest LLM-powered products in European recruitment; a 3.2x ROI improvement across the satellite product portfolio.',
  },
  {
    org: 'Cazoo',
    role: 'Founding team',
    note: "The UK's first fully digital car-buying experience; through hyper-growth to a $7B IPO.",
  },
  {
    org: 'Pivotal, Dallas',
    role: 'Founding hire',
    note: 'Helped companies turn practices into products.',
  },
  {
    org: 'Amazon & AT&T',
    role: 'Early chapters',
    note: 'How very large organisations actually move.',
  },
];

const stats = [
  { num: '$7B', label: 'IPO valuation' },
  { num: '100M+', label: 'Customers served' },
  { num: '£165M+', label: 'Savings unlocked' },
  { num: '26', label: 'Global job markets' },
];
---

<BaseLayout
  title={entry.data.seoTitle ?? `${entry.data.title} | Saielle DaSilva`}
  description={entry.data.description}
  profilePage
>
  <section class="wrap">
    <header class="page-head long-title">
      <p class="eyebrow">About</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">
        Some career highlights.
      </p>
      <ul class="stat-strip" aria-label="Track record in numbers">
        {
          stats.map((s) => (
            <li>
              <span class="stat-num">{s.num}</span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="about-lead">
      <figure class="portrait">
        <div class="portrait-frame">
          <img
            src="/saielle-dasilva.jpg"
            alt="Saielle DaSilva"
            width="360"
            height="480"
          />
        </div>
        <figcaption>Saielle DaSilva</figcaption>
      </figure>

      <div class="prose about-intro">
        <p>
          I started in design. Along the way, I discovered a passion for data.
          The discipline of informing decisions with real evidence and
          measuring real impact became a foundation of my work style.
        </p>
        <p>
          Good software is made of more than good people. Great people are
          everywhere, but good software is harder to find.
        </p>
        <blockquote>
          <p>
            in·ten·tion·aut <em>(n.)</em>: A navigator of intention; one who
            journeys through complexity with a clear sense of what matters and
            why.
          </p>
        </blockquote>
        <p>
          The word is invented, but intention captures the arc of my work.
        </p>
      </div>
    </div>

    <div class="prose about-final">
      <Content />
    </div>

    <section class="arc-section" aria-label="Career arc">
      <h2>A brief history.</h2>
      <ol class="talk-list arc-list">
        {
          arc.map((a) => (
            <li class="talk-row">
              <span class="talk-date">{a.org}</span>
              <div>
                <span class="talk-title">{a.role}</span>
                <p class="talk-desc">{a.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </section>
</BaseLayout>

<style>
  /* The opening prose (down to the definition and the line after it) sits left,
     the portrait right. Everything below - about-final, the arc - is full width,
     so the two-column treatment is scoped to .about-lead only. The text column
     is capped at the same measure as .prose so its left edge lines up with the
     full-width prose below. */
  .about-lead {
    display: grid;
    grid-template-columns: minmax(0, 62ch) 18rem;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Explicit placement so the DOM can keep the portrait first (it leads when the
     grid collapses to one column on narrow screens) while it renders on the
     right here. */
  .about-lead .about-intro {
    grid-column: 1;
    grid-row: 1;
  }

  .about-lead .portrait {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
  }

  .portrait-frame {
    display: block;
    padding: 12px;
    border: 1px solid var(--ink);
    position: relative;
  }

  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid var(--line);
    pointer-events: none;
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Same treatment as .img-caption elsewhere on the site. */
  .portrait figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
  }

  @media (max-width: 720px) {
    .about-lead {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-bottom: clamp(2.5rem, 8vw, 3.5rem);
    }

    .about-lead .about-intro,
    .about-lead .portrait {
      grid-column: auto;
      grid-row: auto;
    }

    .portrait {
      max-width: 15rem;
    }
  }
</style>
