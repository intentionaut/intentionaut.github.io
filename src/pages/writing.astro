---
import BaseLayout from '../layouts/BaseLayout.astro';

const newsletterUrl = 'https://saielle.beehiiv.com';
---

<BaseLayout
  title="Writing — Saielle Dasilva"
  description="Essays and notes by Saielle Dasilva on product leadership, design, data and building with AI."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Writing</p>
      <h1>Thinking in public.</h1>
      <p class="lede">
        Essays and notes on product leadership, design taste, honest use of
        data, and building with AI — without the hype.
      </p>
    </header>

    <a class="substack-card" href={newsletterUrl}>
      <span class="card-kicker">Newsletter</span>
      <span class="card-title">The Second Draft</span>
      <span class="card-sub"
        >Essays on AI, product and data — new issues land here first&nbsp;→</span
      >
    </a>

    <section class="writing-links" aria-label="Other writing">
      <h2>Elsewhere</h2>
      <ol class="talk-list">
        <li class="talk-row">
          <span class="talk-date">Sep 2017</span>
          <div>
            <a
              class="talk-title"
              href="https://uxdesign.cc/letter-to-a-junior-designer-29b5c4471978"
              rel="noopener">Letter to a Junior Designer</a
            >
            <p class="talk-meta">UX Collective · Medium</p>
          </div>
        </li>
      </ol>
    </section>
  </section>
</BaseLayout>
