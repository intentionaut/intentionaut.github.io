---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  writingEntries,
  themeLabels,
  type Theme,
} from '../data/writing';

const entries = [...writingEntries].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf()
);

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const counts = new Map<Theme, number>();
for (const e of entries)
  for (const t of e.themes) counts.set(t, (counts.get(t) ?? 0) + 1);
const themesUsed = [...counts.entries()].sort((a, b) =>
  themeLabels[a[0]].localeCompare(themeLabels[b[0]])
);

const fmtDate = (e: (typeof entries)[number]) =>
  e.dateLabel ?? new Date(e.date).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
  });
---

<BaseLayout
  title="Writing | Saielle DaSilva"
  description="A decade of writing by Saielle DaSilva, from design craft and storytelling to enterprise AI. The Second Draft newsletter and the archive."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Writing</p>
      <h1>Thinking in public.</h1>
      <p class="lede">
        A decade of writing, from design craft to enterprise AI. New essays
        land on The Second Draft first; the archive lives below.
      </p>
    </header>

    <a class="substack-card" href="https://saielle.beehiiv.com">
      <span class="card-kicker">Newsletter</span>
      <span class="card-title">The Second Draft</span>
      <span class="card-sub"
        >Essays on AI, product and data: new issues land here first&nbsp;→</span
      >
    </a>

    <section class="archive" aria-label="Writing archive">
      <div class="chips" role="group" aria-label="Filter writing by theme">
        <button class="chip is-active" data-filter="all" aria-pressed="true">
          Everything <sup>{entries.length}</sup>
        </button>
        {
          themesUsed.map(([t, n]) => (
            <button class="chip" data-filter={t} aria-pressed="false">
              {themeLabels[t]} <sup>{n}</sup>
            </button>
          ))
        }
      </div>

      <ol class="talk-list ledger" id="ledger">
        {
          entries.map((e) => (
            <li
              class="talk-row ledger-row"
              id={`w-${slugify(e.title)}`}
              data-themes={e.themes.join(' ')}
            >
              <span class="talk-date">{fmtDate(e)}</span>
              <div>
                {e.url ? (
                  <a class="talk-title" href={e.url} rel="noopener">
                    {e.title}
                  </a>
                ) : (
                  <span class="talk-title">{e.title}</span>
                )}
                <p class="talk-meta">
                  {e.source}
                  <span class="row-themes">
                    {' · '}
                    {e.themes.map((t) => themeLabels[t]).join(' · ')}
                  </span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="empty is-hidden" id="ledger-empty">
        Nothing filed under that yet.
      </p>
    </section>
  </section>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const rows = document.querySelectorAll<HTMLElement>('.ledger-row');
    const empty = document.getElementById('ledger-empty');

    const applyFilter = (f: string) => {
      let visible = 0;
      rows.forEach((row) => {
        const show =
          f === 'all' || row.dataset.themes?.split(' ').includes(f);
        row.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      if (empty) empty.classList.toggle('is-hidden', visible > 0);
      chips.forEach((c) => {
        const active = c.dataset.filter === f;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', String(active));
      });
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => applyFilter(chip.dataset.filter!))
    );
  </script>
</BaseLayout>
