---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  writingEntries,
  themeLabels,
  type Theme,
} from '../data/writing';

const entries = [...writingEntries].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf()
);

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const counts = new Map<Theme, number>();
for (const e of entries)
  for (const t of e.themes) counts.set(t, (counts.get(t) ?? 0) + 1);
const themesUsed = [...counts.entries()].sort((a, b) =>
  themeLabels[a[0]].localeCompare(themeLabels[b[0]])
);

const fmtDate = (e: (typeof entries)[number]) =>
  e.dateLabel ?? new Date(e.date).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
  });
---

<BaseLayout
  title="Writing | Saielle DaSilva"
  description="Writing by Saielle DaSilva, from design craft and storytelling to enterprise AI. Essays and the archive."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Writing</p>
      <h1>Thinking in public.</h1>
      <p class="lede">
        A decade of writing, from design craft to enterprise AI. New essays
        land on my newsletter for subscribers first; the archive lives below.
      </p>
    </header>

    <section class="signup" aria-label="Newsletter signup">
      <h2>Don't miss the post.</h2>
      <p class="signup-sub">
        Fortnightly thoughts on leadership, impact and getting clear about
        things that matter.
      </p>
      <form
        class="signup-form"
        action="https://embeds.beehiiv.com/96b7bfbb-25ad-448f-a8e8-b4d61019e30d/subscribe"
        method="POST"
        target="_blank"
        rel="noopener noreferrer"
      >
        <label class="sr-only" for="writing-email">Email address</label>
        <input
          class="signup-input"
          type="email"
          id="writing-email"
          name="email"
          placeholder="your@email.com"
          required
        />
        <button class="btn-plain" type="submit">Subscribe</button>
      </form>
    </section>

    <div class="section-rule" aria-hidden="true"></div>

    <section class="archive" aria-label="Writing archive">
      <div class="chips" role="group" aria-label="Filter writing by theme">
        <button class="chip is-active" data-filter="all" aria-pressed="true">
          Everything <sup>{entries.length}</sup>
        </button>
        {
          themesUsed.map(([t, n]) => (
            <button class="chip" data-filter={t} aria-pressed="false">
              {themeLabels[t]} <sup>{n}</sup>
            </button>
          ))
        }
      </div>

      <ol class="talk-list ledger" id="ledger">
        {
          entries.map((e, i) => (
            <li
              class="talk-row ledger-row"
              id={`w-${slugify(e.title)}`}
              data-themes={e.themes.join(' ')}
              data-index={i}
            >
              <span class="talk-date">{fmtDate(e)}</span>
              <div>
                {e.url ? (
                  <a
                    class="talk-title"
                    href={e.url}
                    {...(e.url.startsWith('http')
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {e.title}
                  </a>
                ) : (
                  <span class="talk-title">{e.title}</span>
                )}
                <p class="talk-meta">
                  {e.source}
                  <span class="row-themes">
                    {' · '}
                    {e.themes.map((t) => themeLabels[t]).join(' · ')}
                  </span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="skeleton" id="ledger-skeleton" aria-hidden="true">
        <div class="skeleton-row"><span class="skeleton-date" /><span class="skeleton-title" /></div>
        <div class="skeleton-row"><span class="skeleton-date" /><span class="skeleton-title" /></div>
        <div class="skeleton-row"><span class="skeleton-date" /><span class="skeleton-title" /></div>
        <div class="skeleton-row"><span class="skeleton-date" /><span class="skeleton-title" /></div>
        <div class="skeleton-row"><span class="skeleton-date" /><span class="skeleton-title" /></div>
        <div class="skeleton-row"><span class="skeleton-date" /><span class="skeleton-title" /></div>
      </div>
      <p class="empty is-hidden" id="ledger-empty">
        Nothing filed under that yet.
      </p>
    </section>

    <section class="signup" aria-label="Subscribe">
      <h2>Want the next one?</h2>
      <p class="signup-sub">
        Join readers getting new essays on leadership, design and AI.
      </p>
      <form
        class="signup-form"
        action="https://embeds.beehiiv.com/96b7bfbb-25ad-448f-a8e8-b4d61019e30d/subscribe"
        method="POST"
        target="_blank"
        rel="noopener noreferrer"
      >
        <label class="sr-only" for="writing-bottom-email">Email address</label>
        <input
          class="signup-input"
          type="email"
          id="writing-bottom-email"
          name="email"
          placeholder="your@email.com"
          required
        />
        <button class="btn-plain" type="submit">Subscribe</button>
      </form>
    </section>
  </section>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const rows = document.querySelectorAll<HTMLElement>('.ledger-row');
    const empty = document.getElementById('ledger-empty');
    const skeleton = document.getElementById('ledger-skeleton');

    const applyFilter = (f: string) => {
      let visible = 0;
      rows.forEach((row) => {
        const show =
          f === 'all' || row.dataset.themes?.split(' ').includes(f);
        row.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      if (empty) empty.classList.toggle('is-hidden', visible > 0);
      chips.forEach((c) => {
        const active = c.dataset.filter === f;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', String(active));
      });
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => applyFilter(chip.dataset.filter!))
    );

    const BATCH = 6;
    let loaded = 0;

    const loadBatch = () => {
      const batch = [...rows].slice(loaded, loaded + BATCH);
      batch.forEach((row, i) => {
        setTimeout(() => row.classList.add('is-visible'), i * 80);
      });
      loaded += batch.length;
    };

    if (skeleton) skeleton.remove();

    loadBatch();

    const checkScroll = () => {
      if (loaded >= rows.length) return;
      const lastVisible = rows[loaded - 1];
      if (!lastVisible) return;
      const rect = lastVisible.getBoundingClientRect();
      if (rect.bottom < window.innerHeight + 300) {
        loadBatch();
      }
    };

    window.addEventListener('scroll', checkScroll, { passive: true });
    checkScroll();
  </script>
</BaseLayout>
