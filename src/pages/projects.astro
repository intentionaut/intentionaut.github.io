---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout
  title="Projects | Saielle DaSilva"
  description="Case studies and samples by Saielle DaSilva, from early-stage products to enterprise AI platforms."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>Leaders work at all levels.</h1>
      <p class="lede">
        I work farm-to-table: hands-on across the whole product lifecycle,
        from strategy to shipped. Here are some things I'm proud to show off.
      </p>
    </header>

    <ol class="project-list">
      {
        projects.map((project) => (
          <li class="project-row">
            <a class="project-card" href={`/projects/${project.id}`}>
              <span class="talk-title">{project.data.title}</span>
              <span class="project-summary">{project.data.summary}</span>
              <span class="talk-meta">
                {project.data.role}
                {project.data.status && ` · ${project.data.status}`}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
