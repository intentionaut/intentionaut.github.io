---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
  const da = a.data.date?.valueOf() ?? 0;
  const db = b.data.date?.valueOf() ?? 0;
  return db - da;
});
---

<BaseLayout
  title="Projects — Saielle DaSilva"
  description="Things Saielle DaSilva has built — including Friday, a career coach for early-career film, TV and theatre crew."
>
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>Leaders work at all levels.</h1>
      <p class="lede">
        The clearest product thinking happens hands-on. These are things I've
        built — quickly, independently, and for people who needed them to
        exist.
      </p>
    </header>

    <ol class="project-list">
      {
        projects.map((project) => (
          <li class="project-row">
            <a class="talk-title" href={`/projects/${project.id}`}>
              {project.data.title}
            </a>
            <p class="project-summary">{project.data.summary}</p>
            <p class="talk-meta">
              {project.data.role}
              {project.data.status && ` · ${project.data.status}`}
            </p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
