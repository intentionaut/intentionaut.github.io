---
/**
 * Formats and prices for every workshop page. Prices, hours, per-hour figures
 * and the full-day saving all come from rates.ts, never typed here.
 */
import { rates, gbp, workshopHours, workshopGroup, workshopExtraPerson } from '../data/rates';

interface Props {
  id?: string;
}
const { id = 'formats' } = Astro.props;

const perHour = (price: number, hours: number) => gbp(Math.round(price / hours));
const rows = [
  { name: `Taster · ${workshopHours.taster} hours`, price: rates.workshopTaster, hours: workshopHours.taster },
  { name: `Half day · up to ${workshopHours.halfDay} hours`, price: rates.workshopHalfDay, hours: workshopHours.halfDay },
  { name: `Full day · ${workshopHours.fullDay} hours`, price: rates.workshop, hours: workshopHours.fullDay },
];
// "Best value" goes to the lowest price per hour, so the label cannot drift from the rates.
const bestHourly = Math.min(...rows.map((r) => r.price / r.hours));
const priced = rows.map((r) => ({ ...r, best: r.price / r.hours === bestHourly }));
---

<section class="rates-section workshop-pricing" id={id} aria-label="Formats and prices">
  <h2>Formats and prices</h2>
  <p class="rates-intro">
    Every workshop runs remote or in person and includes a scoping call,
    materials and written follow-up. Each price covers up to
    {workshopGroup.included} people; each extra person is
    {gbp(workshopExtraPerson)}, up to {workshopGroup.max}.
  </p>
  <div class="prose">
    <table>
      <thead>
        <tr><th>Format</th><th>Price</th><th>Per hour</th></tr>
      </thead>
      <tbody>
        {priced.map((r) => (
          <tr>
            <td>{r.name}{r.best && <strong> · Best value</strong>}</td>
            <td>From {gbp(r.price)}</td>
            <td>{perHour(r.price, r.hours)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .workshop-pricing .prose {
    max-width: 52rem;
    padding-bottom: 0;
  }
  .workshop-pricing td:nth-child(n + 2),
  .workshop-pricing th {
    white-space: nowrap;
  }
</style>
