---
/**
 * Formats and prices for every workshop page, as talk rows from the design
 * system. Prices and hours come from rates.ts, never typed here. Ordered by
 * length; two hours is its own format (alignment, inspiration, Q&A), not a taster.
 */
import { rates, gbp, workshopHours, workshopGroup, workshopExtraPerson } from '../data/rates';

interface Props {
  id?: string;
}
const { id = 'formats' } = Astro.props;

const formats = [
  { name: `${workshopHours.taster} hours`, price: rates.workshopTaster, what: 'Alignment, inspiration and Q&A.' },
  { name: `Half day · up to ${workshopHours.halfDay} hours`, price: rates.workshopHalfDay, what: 'Your team works its own decision through.' },
  { name: `Full day · ${workshopHours.fullDay} hours`, price: rates.workshop, what: 'A second decision, or a hands-on rehearsal.' },
];
const terms = [
  { label: 'Group', text: `Up to ${workshopGroup.included} people included` },
  { label: 'Extra people', text: `${gbp(workshopExtraPerson)} each, up to ${workshopGroup.max}` },
  { label: 'Travel', text: 'None for remote or London; at cost elsewhere, agreed before booking' },
  { label: 'Materials', text: 'Included' },
];
---

<section class="rates-section workshop-pricing" id={id} aria-label="Formats and prices">
  <h2>Formats and prices</h2>
  <p class="rates-intro">Most workshops run as a half-day format for best fit.</p>
  <ul class="talk-list workshop-formats">
    {formats.map((f) => (
      <li class="talk-row">
        <span class="talk-date">From {gbp(f.price)}</span>
        <div><span class="talk-title">{f.name}</span><p class="talk-meta">{f.what}</p></div>
      </li>
    ))}
  </ul>
  <ul class="talk-list">
    {terms.map((t) => (
      <li class="talk-row">
        <span class="talk-date">{t.label}</span>
        <div><p class="talk-meta">{t.text}</p></div>
      </li>
    ))}
  </ul>
</section>

<style>
  .workshop-formats {
    padding-bottom: var(--space-7);
  }
</style>
