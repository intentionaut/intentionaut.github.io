---
/**
 * Formats and prices for every workshop page. Prices, hours, per-hour figures
 * and the full-day saving all come from rates.ts, never typed here.
 */
import { rates, gbp, workshopHours, workshopGroup, workshopExtraPerson } from '../data/rates';

interface Props {
  id?: string;
}
const { id = 'formats' } = Astro.props;

const perHour = (price: number, hours: number) => gbp(Math.round(price / hours));
const rows = [
  { name: `Taster · ${workshopHours.taster} hours`, price: rates.workshopTaster, hours: workshopHours.taster },
  { name: `Half day · up to ${workshopHours.halfDay} hours`, price: rates.workshopHalfDay, hours: workshopHours.halfDay },
  { name: `Full day · ${workshopHours.fullDay} hours`, price: rates.workshop, hours: workshopHours.fullDay },
];
// "Best value" goes to the lowest price per hour, so the label cannot drift from the rates.
const bestHourly = Math.min(...rows.map((r) => r.price / r.hours));
const priced = rows.map((r) => ({ ...r, best: r.price / r.hours === bestHourly }));
---

<section class="rates-section workshop-pricing" id={id} aria-label="Formats and prices">
  <h2>Formats and prices</h2>
  <ul class="tiers">
    {priced.map((r) => (
      <li class:list={['tier', { best: r.best }]}>
        {r.best && <span class="flag">Best value</span>}
        <p class="tier-name">{r.name}</p>
        <p class="tier-price">{gbp(r.price)}</p>
        <p class="tier-hour">from · {perHour(r.price, r.hours)} an hour</p>
      </li>
    ))}
  </ul>
  <ul class="terms">
    <li>Up to {workshopGroup.included} people included</li>
    <li>{gbp(workshopExtraPerson)} per extra person, up to {workshopGroup.max}</li>
    <li>Travel at cost outside London</li>
    <li>Materials included</li>
  </ul>
</section>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
  }
  .tier {
    position: relative;
    border: 1px solid var(--slate);
    border-radius: var(--radius-l);
    padding: var(--space-6) var(--space-5) var(--space-5);
  }
  .tier.best {
    border: 2px solid var(--accent);
  }
  .flag {
    position: absolute;
    top: -0.7rem;
    left: var(--space-5);
    background: var(--accent);
    color: var(--paper);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.1rem var(--space-2);
    border-radius: var(--radius-s);
  }
  .tier p {
    margin: 0;
  }
  .tier-price {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.1;
    margin: var(--space-2) 0 var(--space-1) !important;
  }
  .tier-hour {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .terms li::before {
    content: '·';
    color: var(--accent-text);
    margin-right: var(--space-2);
  }
</style>
