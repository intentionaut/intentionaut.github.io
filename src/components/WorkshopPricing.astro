---
/**
 * Formats and prices for every workshop page. Prices, hours, per-hour figures
 * and the full-day saving all come from rates.ts, never typed here.
 */
import { rates, gbp, workshopHours, workshopFullDaySaving, workshopGroup, workshopExtraPerson } from '../data/rates';

interface Props {
  id?: string;
}
const { id = 'formats' } = Astro.props;

const perHour = (price: number, hours: number) => gbp(Math.round(price / hours));
const rows = [
  { name: `Taster · ${workshopHours.taster} hours`, price: rates.workshopTaster, hours: workshopHours.taster, what: 'A first look at one decision, using a prepared case.' },
  { name: `Half day · up to ${workshopHours.halfDay} hours`, price: rates.workshopHalfDay, hours: workshopHours.halfDay, what: 'Your team works its own decision through.' },
  { name: `Full day · ${workshopHours.fullDay} hours`, price: rates.workshop, hours: workshopHours.fullDay, best: true, what: `Two half days' work for ${gbp(workshopFullDaySaving)} less, with a hands-on rehearsal or a second decision.` },
];
---

<section class="rates-section workshop-pricing" id={id} aria-label="Formats and prices">
  <h2>Formats and prices</h2>
  <p class="rates-intro">
    Every workshop runs remote or in person and includes a scoping call,
    materials and written follow-up. Each price covers up to
    {workshopGroup.included} people; each extra person is
    {gbp(workshopExtraPerson)}, up to {workshopGroup.max}.
  </p>
  <div class="prose">
    <table>
      <thead>
        <tr><th>Format</th><th>Price</th><th>Per hour</th><th>What you get</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>{r.name}</td>
            <td>From {gbp(r.price)}</td>
            <td>{perHour(r.price, r.hours)}</td>
            <td>{r.best && <strong>Best value. </strong>}{r.what}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .workshop-pricing .prose {
    max-width: 52rem;
    padding-bottom: 0;
  }
  .workshop-pricing td:nth-child(-n + 3),
  .workshop-pricing th {
    white-space: nowrap;
  }
  /* On phones the fourth column sat off-screen with no hint it was there.
     Each row becomes format, price, per hour, then what you get underneath. */
  @media (max-width: 560px) {
    .workshop-pricing thead th:nth-child(4) {
      display: none;
    }
    .workshop-pricing tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 6rem 4.75rem;
      column-gap: var(--space-4);
      border-bottom: 1px solid var(--slate);
    }
    .workshop-pricing thead tr {
      border-bottom-color: var(--ink);
    }
    .workshop-pricing td,
    .workshop-pricing th {
      border-bottom: 0;
    }
    .workshop-pricing td:first-child {
      white-space: normal;
    }
    .workshop-pricing td:nth-child(4) {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }
</style>
