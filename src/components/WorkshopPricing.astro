---
/**
 * Formats and prices for every workshop page, as talk rows from the design
 * system. Prices and hours come from rates.ts, never typed here. The half day
 * leads: it is the usual format, and the others are there when they fit better.
 */
import { rates, gbp, workshopHours, workshopGroup, workshopExtraPerson } from '../data/rates';

interface Props {
  id?: string;
}
const { id = 'formats' } = Astro.props;

const formats = [
  { name: `Half day · up to ${workshopHours.halfDay} hours`, price: rates.workshopHalfDay },
  { name: `Taster · ${workshopHours.taster} hours`, price: rates.workshopTaster },
  { name: `Full day · ${workshopHours.fullDay} hours`, price: rates.workshop },
];
const terms = [
  { label: 'Group', text: `Up to ${workshopGroup.included} people included` },
  { label: 'Extra people', text: `${gbp(workshopExtraPerson)} each, up to ${workshopGroup.max}` },
  { label: 'Travel', text: 'None for remote or London; at cost elsewhere, agreed before booking' },
  { label: 'Materials', text: 'Included' },
];
---

<section class="rates-section workshop-pricing" id={id} aria-label="Formats and prices">
  <h2>Formats and prices</h2>
  <p class="rates-intro">Most workshops run as a half day. A taster or a full day is there when it fits better.</p>
  <ul class="talk-list workshop-formats">
    {formats.map((f) => (
      <li class="talk-row">
        <span class="talk-date">From {gbp(f.price)}</span>
        <div><span class="talk-title">{f.name}</span></div>
      </li>
    ))}
  </ul>
  <ul class="talk-list">
    {terms.map((t) => (
      <li class="talk-row">
        <span class="talk-date">{t.label}</span>
        <div><p class="talk-meta">{t.text}</p></div>
      </li>
    ))}
  </ul>
</section>

<style>
  .workshop-formats {
    padding-bottom: var(--space-7);
  }
</style>
