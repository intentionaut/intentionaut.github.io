---
/**
 * Formats and prices for every workshop page, as talk rows from the design
 * system. Prices and hours come from rates.ts, never typed here. Ordered by
 * length; two hours is its own format (alignment, inspiration, Q&A), not a taster.
 */
import { rates, gbp, workshopHours, workshopGroup, workshopExtraPerson } from '../data/rates';

interface Props {
  id?: string;
}
const { id = 'formats' } = Astro.props;

const formats = [
  { name: 'Sense-check', length: `${workshopHours.taster} hours`, price: rates.workshopTaster, what: 'A second view on one problem area before you commit more time. Your leaders leave aligned on what matters, with options to pursue and their hardest questions answered.' },
  { name: 'Team workshop', length: `Half day, up to ${workshopHours.halfDay} hours`, price: rates.workshopHalfDay, what: 'One problem area worked through with your team or one leader. You leave with a one-page strategy or a maturity charter, owners named and next steps dated.' },
  { name: 'Leadership day', length: `Full day, ${workshopHours.fullDay} hours`, price: rates.workshop, what: "A whole domain with your leadership team, with room to test an idea together or work through what's holding the team back. You leave with a strategy everyone is moving on, owners and dates." },
];
---

<section class="rates-section workshop-pricing" id={id} aria-label="Formats and prices">
  <h2>Formats and prices</h2>
  <p class="rates-intro">Most workshops run as a half-day format for best fit.</p>
  <ul class="talk-list workshop-formats">
    {formats.map((f) => (
      <li class="talk-row">
        <span class="talk-date"><span class="from">From</span><span class="price">{gbp(f.price)}</span></span>
        <div><span class="talk-title">{f.name}</span><p class="talk-meta">{f.length}</p><p class="talk-meta">{f.what}</p></div>
      </li>
    ))}
  </ul>
  <p class="workshop-terms">
    Every price includes up to {workshopGroup.included} people, materials, a
    scoping call and written follow-up. Extra people are
    {gbp(workshopExtraPerson)} each, up to {workshopGroup.max}. There's no
    travel charge for remote sessions or London; elsewhere it's at cost,
    agreed before you book.
  </p>
</section>

<style>
  .workshop-formats {
    padding-bottom: var(--space-6);
  }
  /* The price leads; the format name steps back to regular weight. */
  .workshop-formats .talk-title {
    font-weight: 400;
  }
  .workshop-terms {
    max-width: 40rem;
    font-size: var(--text-sm);
  }
  /* Prices read as the answer: ink, display face, a step up from body. */
  .workshop-formats .talk-date {
    padding-top: 0;
    color: var(--ink);
    letter-spacing: normal;
    text-transform: none;
  }
  .workshop-formats .from {
    display: block;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .workshop-formats .price {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.2;
  }
</style>
