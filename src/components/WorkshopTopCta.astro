---
import { BOOKING_URL } from '../data/links';
import { rates, gbp } from '../data/rates';

interface Props {
  formatsHref?: string;
}
const { formatsHref = '#formats' } = Astro.props;
---

<div class="cta-row">
  <a class="btn-primary" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a free scoping call</a>
  <a class="link-arrow" href={formatsHref}><span>From {gbp(rates.workshopTaster)} · see formats</span></a>
</div>

<style>
  .cta-reassure {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
