---
import type { Recommendation } from '../data/writing';

interface Props {
  items: Recommendation[];
  heading: string;
}

const { items, heading } = Astro.props;

const fmtDate = (e: Recommendation['entry']) =>
  e.dateLabel ??
  new Date(e.date).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
  });
---

{
  items.length > 0 && (
    <section class="recs arc-section" aria-label={heading}>
      <h2>{heading}</h2>
      <ol class="talk-list">
        {items.map(({ entry, blurb }) => (
          <li class="talk-row">
            <span class="talk-date">{fmtDate(entry)}</span>
            <div>
              <a
                class="talk-title"
                href={entry.url}
                {...(entry.url?.startsWith('http')
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {entry.title}
              </a>
              <p class="talk-meta">{entry.source}</p>
              <p class="talk-desc">{blurb}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="rec-more">
        <a class="link-arrow" href="/writing/">
          <span>The full archive</span>
        </a>
      </p>
    </section>
  )
}

<style>
  .rec-more {
    margin-top: var(--space-7);
  }
</style>
