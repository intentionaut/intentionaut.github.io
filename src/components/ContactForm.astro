---
/**
 * The enquiry form used on /contact/ and every service page. It was copied
 * into ten pages and had drifted (three topic lists, no double-submit guard);
 * now there is one.
 *
 * Posts to the contact-form Worker (/contact), which emails hello@. BaseLayout
 * adds the first_* arrival fields to #contact-form, so the id must stay.
 */
import { BOOKING_URL } from '../data/links';

interface Props {
  /** Which page sent it, e.g. "fractional". Omit on /contact/. */
  source?: string;
  /** Topic pre-selected in the dropdown. */
  selected?: string;
  rows?: number;
  /** Show "Rather talk first? Book a free call." under the form. */
  booking?: boolean;
  /** Add "If I'm not the right fit…" to the reply promise. Consulting pages only. */
  referral?: boolean;
}

const { source, selected, rows = 5, booking = false, referral = false } = Astro.props;

const TURNSTILE_SITEKEY = '0x4AAAAAAEcCwzuExy2fSCmH';

// Values match the Worker's label map in contact-form/src/index.ts.
const topics: [string, string][] = [
  ['forward-deployed', 'Product building'],
  ['fractional', 'Fractional leadership'],
  ['strategic-direction', 'Strategic direction'],
  ['execution', 'Execution & transformation'],
  ['advisor-intro', 'Advisor or recruiter introduction'],
  ['speaking', 'Speaking & workshops'],
  ['mentoring', 'Mentoring'],
  ['other', 'Something else'],
];
---

<form id="contact-form" novalidate>
  {source && <input type="hidden" name="source" value={source} />}
  <div class="form-grid">
    <label>
      <span class="form-label">Name</span>
      <input type="text" name="name" required autocomplete="name" maxlength="100" />
    </label>
    <label>
      <span class="form-label">Email</span>
      <input type="email" name="email" required autocomplete="email" maxlength="254" />
    </label>
  </div>
  <label>
    <span class="form-label">What's this about?</span>
    <select name="topic">
      {topics.map(([value, label]) => (
        <option value={value} selected={value === selected}>{label}</option>
      ))}
    </select>
  </label>
  <label>
    <span class="form-label">Message</span>
    <textarea name="message" rows={rows} required maxlength="5000"></textarea>
  </label>
  {/* Honeypot: hidden from people, filled by bots. The Worker drops any
      message that has it. */}
  <input class="hp-field" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-theme="light" data-appearance="interaction-only"></div>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <p class="form-promise">
    I reply to every note, usually within a couple of working days.
    {referral && " If I'm not the right fit, I'll point you to someone who is."}
  </p>
  <button class="btn-plain" type="submit">Send it</button>
  <p class="form-status" id="form-status" role="status"></p>
</form>
{/* Shown in place of the form once the Worker confirms the send. A line of
    status text under a cleared form was too easy to miss. */}
<div class="form-sent" id="form-sent" tabindex="-1" hidden>
  <span class="received-stamp" aria-hidden="true">Received<small data-sent-date></small></span>
  <p class="form-sent-title">Message sent.</p>
  <p>
    Thank you<span data-sent-name></span>. It is in my inbox now, and I reply to
    every note, usually within a couple of working days.
  </p>
  <p>
    Rather talk sooner?
    {' '}<a href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a free call</a>.
  </p>
</div>
{
  booking && (
    <p class="form-alt" id="form-alt">
      Rather talk first?
      {' '}<a href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a free call</a>.
    </p>
  )
}

<style>
  /* The site's form layout sets display, which beats the hidden attribute. */
  form[hidden],
  .form-alt[hidden] {
    display: none;
  }
  .form-sent {
    padding: 0;
  }
  .form-sent:focus {
    outline: none;
  }
  /* An office stamp, pressed once, set slightly askew. Decorative: the title says it. */
  .received-stamp {
    position: relative;
    display: inline-block;
    /* Room for the tilt, so the corners never clip. */
    margin: 6px 0 var(--space-4) 6px;
    padding: var(--space-1) var(--space-3);
    border: 2px solid var(--accent-text);
    color: var(--accent-text);
    font: 600 0.78rem var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transform: rotate(-6deg);
    animation: stamp-press 0.45s var(--ease-out) both;
  }
  .received-stamp::after {
    content: '';
    position: absolute;
    inset: 2px;
    border: 1px solid var(--accent-text);
    opacity: 0.5;
  }
  .received-stamp small {
    display: block;
    font: 500 0.56rem var(--font-body);
    letter-spacing: 0.14em;
    text-align: center;
  }
  @keyframes stamp-press {
    from {
      opacity: 0;
      transform: rotate(-6deg) scale(1.35);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .received-stamp {
      animation: none;
    }
  }
  .form-sent-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.2;
    color: var(--ink);
  }
  .form-sent p:not(.form-sent-title) {
    margin: 0 0 var(--space-3);
    color: var(--ink);
  }
  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    padding: 0;
  }
</style>

<script>
  import { trackEvent } from '../lib/pendo';
  import { BOOKING_URL } from '../data/links';

  const ENDPOINT = 'https://contact-form.intentionaut.workers.dev/contact';
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const sent = document.getElementById('form-sent');
  const bookingLine = document.getElementById('form-alt');
  const buttonLabel = button?.textContent ?? 'Send it';

  const say = (msg: string) => {
    if (statusEl) statusEl.textContent = msg;
  };

  const link = (href: string, text: string, external: boolean) => {
    const a = document.createElement('a');
    a.href = href;
    a.textContent = text;
    if (external) {
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
    }
    return a;
  };

  // shortcut: a Worker error counts as visitor-written only if it reads as one
  // short sentence; upgrade to a code from the Worker once it sends one.
  const visitorMessage = (error: unknown) =>
    typeof error === 'string' && /^[A-Z][^<>]{0,198}[.!?]$/.test(error.trim()) ? error.trim() : '';

  // Built from DOM nodes and textContent only: Worker text is never parsed as HTML.
  const sayFailure = (workerError?: string) => {
    if (!statusEl) return;
    const nodes: (string | Node)[] = [];
    const own = visitorMessage(workerError);
    if (own) nodes.push(`${own} `);
    nodes.push(
      "That message didn't send. Your text is still here, so you can try again, or email ",
      link('mailto:hello@intentionaut.com', 'hello@intentionaut.com', false),
      ', or ',
      link(BOOKING_URL, 'Book a free call', true),
      '.',
    );
    statusEl.replaceChildren(...nodes);
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    // One click, one email: the button stays off until this attempt finishes.
    if (button?.disabled) return;
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }
    say('');

    const data = Object.fromEntries(new FormData(form));
    const field = (key: string) => {
      const value = data[key];
      return typeof value === 'string' ? value : undefined;
    };
    // Topic, sending page and first-touch arrival only. Never the name, email
    // or message. /contact/ itself sends no source field.
    const attribution = {
      topic: field('topic'),
      source: field('source') || 'contact',
      first_source: field('first_source'),
      first_medium: field('first_medium'),
      first_campaign: field('first_campaign'),
      first_landing: field('first_landing'),
      first_referrer: field('first_referrer'),
    };

    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = (await res.json().catch(() => ({}))) as { message?: string; error?: string };
      if (res.ok) {
        trackEvent('contact_enquiry_sent', attribution);
        // First name only, capitalised. The email address is deliberately not
        // echoed back: the screen may be shared or screenshotted.
        const first = String(data.name ?? '').trim().split(/\s+/)[0] ?? '';
        const firstName = first ? first[0].toLocaleUpperCase() + first.slice(1) : '';
        const nameSlot = sent?.querySelector('[data-sent-name]');
        if (nameSlot) nameSlot.textContent = firstName ? `, ${firstName}` : '';
        const dateSlot = sent?.querySelector('[data-sent-date]');
        if (dateSlot) dateSlot.textContent = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
        // Hold the card at its current height so nothing below it moves, then
        // swap the heading, intro and form for the confirmation.
        const card = form.closest<HTMLElement>('.contact-card');
        if (card) {
          card.style.minHeight = `${card.offsetHeight}px`;
          card.classList.add('is-sent');
        }
        form.reset();
        form.hidden = true;
        if (bookingLine) bookingLine.hidden = true;
        if (sent) {
          sent.hidden = false;
          // Focus so screen readers announce it; no scroll, it appears in place.
          sent.focus({ preventScroll: true });
        } else {
          say(result.message || "Thank you; I'll reply soon.");
        }
      } else {
        trackEvent('contact_enquiry_failed', {
          topic: attribution.topic,
          source: attribution.source,
          http_status: res.status,
          error_type: 'http_error',
          first_source: attribution.first_source,
          first_campaign: attribution.first_campaign,
        });
        sayFailure(result.error);
      }
    } catch {
      trackEvent('contact_enquiry_failed', {
        topic: attribution.topic,
        source: attribution.source,
        error_type: 'network_error',
        first_source: attribution.first_source,
        first_campaign: attribution.first_campaign,
      });
      sayFailure();
    } finally {
      // A Turnstile token is single-use; a retry needs a fresh one.
      (window as any).turnstile?.reset?.();
      if (button) {
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    }
  });
</script>
