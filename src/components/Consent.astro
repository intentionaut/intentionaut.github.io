---
/**
 * Cookie consent, and PostHog behind it.
 *
 * Nothing from PostHog loads, and no cookie is set, until the reader presses
 * Accept. The choice itself is kept in localStorage ('consent' = yes | no):
 * remembering a refusal is strictly necessary, or the banner would ask again
 * on every page. Decline is the same size and weight as Accept, because
 * refusing has to be as easy as agreeing.
 *
 * Pages that can carry a case-study key in the URL fragment pass `disabled`
 * (BaseLayout's noAnalytics), so PostHog never runs where a key could be read.
 * Everywhere else the fragment is stripped from every URL before it is sent.
 */
interface Props {
  disabled?: boolean;
}
const { disabled = false } = Astro.props;

// Public project key: it identifies the project, it cannot read data.
const POSTHOG_KEY = 'phc_p2f3kZLXM7tjJ47PFtHwhKALFks4qz6ZPCdv4EnWVyv4';
// Novus by Pendo app key: public, identifies the app.
const PENDO_KEY = '1aa2cec7-ac47-43ce-8b5c-1f396b553619';
const enabled = import.meta.env.PROD && !disabled;
---

{enabled && (
  <>
    <section class="consent" id="consent" role="dialog" aria-labelledby="consent-h" aria-describedby="consent-p" hidden>
      <h2 id="consent-h">Cookies</h2>
      <p id="consent-p">
        May the site use analytics cookies?
        No advertising. No sale of data. <a href="/privacy/#analytics">Privacy</a>
      </p>
      <div class="consent-row">
        <button type="button" class="consent-btn consent-yes" data-consent="yes">Accept</button>
        <button type="button" class="consent-btn" data-consent="no">Decline</button>
      </div>
    </section>

    <script is:inline define:vars={{ POSTHOG_KEY, PENDO_KEY }}>
      (function () {
        var KEY = 'consent';
        var box = document.getElementById('consent');
        function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }

        function strip(u) { return typeof u === 'string' ? u.split('#')[0] : u; }

        // Survey cap: at most 3 showings in 30 days, never after an answer.
        // The PostHog survey has a selector condition on #survey-ok and a
        // 7-day wait, so PostHog itself keeps showings 7 days apart.
        var SKEY = 'survey-shown';
        function shown() { try { return JSON.parse(localStorage.getItem(SKEY) || '[]'); } catch (e) { return []; } }
        function surveyAllowed(now) {
          var s = shown();
          if (s.indexOf('sent') !== -1) return false;
          return s.filter(function (t) { return typeof t === 'number' && now - t < 30 * 864e5; }).length < 3;
        }
        function noteSurvey(ev) {
          if (!ev || (ev.event !== 'survey shown' && ev.event !== 'survey sent')) return;
          var s = shown();
          s.push(ev.event === 'survey sent' ? 'sent' : Date.now());
          try { localStorage.setItem(SKEY, JSON.stringify(s.slice(-10))); } catch (e) {}
        }
        function markSurvey() {
          if (!surveyAllowed(Date.now()) || document.getElementById('survey-ok')) return;
          var m = document.createElement('div');
          m.id = 'survey-ok';
          m.hidden = true;
          document.body.appendChild(m);
        }

        function load() {
          loadPendo();
          if (window.posthog && window.posthog.__loaded) return;
          markSurvey();
          // PostHog's loader snippet; only the asset URL changes, to load array.js through the proxy (e.intentionaut.com, PostHog's EU managed proxy) so ad blockers that block posthog.com by name still count consenting visitors.
          !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags onFeatureFlags identify setPersonProperties".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
          window.posthog.init(POSTHOG_KEY, {
            api_host: 'https://e.intentionaut.com',
            ui_host: 'https://eu.posthog.com',
            person_profiles: 'identified_only',
            disable_session_recording: true,
            // Case-study keys live in the fragment: never let one leave the page.
            before_send: function (ev) {
              noteSurvey(ev);
              if (ev && ev.properties) {
                ['$current_url', '$referrer', '$initial_current_url'].forEach(function (k) {
                  if (ev.properties[k]) ev.properties[k] = strip(ev.properties[k]);
                });
              }
              return ev;
            },
          });
          document.dispatchEvent(new CustomEvent('posthog:ready'));
        }

        // Novus by Pendo (US-hosted). Same gate as PostHog: nothing loads before Accept.
        function loadPendo() {
          if (window.pendo) { if (window.pendo.startSendingEvents) window.pendo.startSendingEvents(); return; }
          (function(p,e,n,d,o){var v,w,x,y,z;o=p[d]=p[d]||{};o._q=o._q||[];
          v=['initialize','identify','updateOptions','pageLoad','track','trackAgent'];for(w=0,x=v.length;w<x;++w)(function(m){
          o[m]=o[m]||function(){o._q[m===v[0]?'unshift':'push']([m].concat([].slice.call(arguments,0)));};})(v[w]);
          y=e.createElement(n);y.async=!0;y.src='https://cdn.pendo.io/agent/static/'+PENDO_KEY+'/pendo.js';
          z=e.getElementsByTagName(n)[0];z.parentNode.insertBefore(y,z);})(window,document,'script','pendo');
          // Case-study keys live in the fragment: clear it before Pendo records a URL.
          window.pendo.initialize({ visitor: { id: '' }, location: { transforms: [{ attr: 'hash', action: 'Clear' }] } });
        }

        // Withdrawal: stop sending and clear Pendo's stored identifiers.
        function stopPendo() {
          if (window.pendo && window.pendo.stopSendingEvents) window.pendo.stopSendingEvents();
          try {
            Object.keys(localStorage).forEach(function (k) { if (k.indexOf('_pendo_') === 0) localStorage.removeItem(k); });
            Object.keys(sessionStorage).forEach(function (k) { if (k.indexOf('_pendo_') === 0) sessionStorage.removeItem(k); });
          } catch (e) {}
          document.cookie.split(';').forEach(function (c) {
            var n = c.split('=')[0].trim();
            if (n.indexOf('_pendo_') === 0) document.cookie = n + '=; Max-Age=0; path=/';
          });
        }

        function choose(v) {
          set(v);
          box.hidden = true;
          if (v === 'yes') load();
          else {
            if (window.posthog && window.posthog.opt_out_capturing) window.posthog.opt_out_capturing();
            stopPendo();
          }
        }

        box.querySelectorAll('[data-consent]').forEach(function (b) {
          b.addEventListener('click', function () { choose(b.getAttribute('data-consent')); });
        });
        document.addEventListener('click', function (e) {
          var t = e.target.closest && e.target.closest('[data-cookie-settings]');
          if (t) { e.preventDefault(); box.hidden = false; box.querySelector('.consent-yes').focus(); }
        });

        var c = get();
        if (c === 'yes') load();
        else if (c !== 'no') box.hidden = false;

        // Named events the experiment and dashboard read. Autocapture sees the
        // clicks too, but a name survives copy and layout changes.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || !window.posthog || !window.posthog.capture || get() !== 'yes') return;
          if (a.href.indexOf('calendar.app.google') !== -1) {
            window.posthog.capture('booking_click', { page: location.pathname, label: (a.textContent || '').trim() });
          }
        });
        document.addEventListener('submit', function (e) {
          if (e.target && e.target.id === 'contact-form' && window.posthog && get() === 'yes') {
            window.posthog.capture('enquiry_sent', { page: location.pathname });
          }
        });
      })();
    </script>
  </>
)}

<style>
  .consent {
    position: fixed;
    /* right side: hero copy and its buttons are left-aligned */
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: var(--z-skip);
    width: min(26rem, calc(100% - 2.5rem));
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 0;
    padding: 1.4rem 1.4rem 1.2rem;
    box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--ink) 55%, transparent);
    animation: consent-in 0.7s var(--ease-out) 0.4s both;
  }
  .consent[hidden] {
    display: none;
  }
  .consent::before {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1px solid var(--ink);
    border-radius: 0;
    pointer-events: none;
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .consent h2 {
    margin: 0 0 0.4rem;
    font: 500 0.76rem var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .consent p {
    margin: 0 0 1.1rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .consent p a {
    color: var(--ink);
  }
  .consent-row {
    display: flex;
    gap: 0.7rem;
  }
  .consent-btn {
    font: 500 0.74rem var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.85em 1.4em;
    border-radius: 0;
    cursor: pointer;
    border: 1px solid var(--ink);
    background: none;
    color: var(--ink);
  }
  .consent-yes {
    background: var(--ink);
    color: var(--paper);
  }
  .consent-btn:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .consent {
      animation: none;
    }
  }
  /* Below 1280px the corner box would cover the hero copy: a slim bar along
     the bottom instead, double-ruled on top like the cards. */
  @media (max-width: 1279px) {
    .consent {
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      border: 0;
      border-top: 1px solid var(--ink);
      padding: 0.7rem max(var(--space-4), calc((100% - 72rem) / 2));
      display: flex;
      align-items: center;
      gap: 0.4rem var(--space-6);
      box-shadow: 0 -10px 30px -22px color-mix(in srgb, var(--ink) 55%, transparent);
    }
    .consent::before {
      inset: 3px 0 auto;
      border: 0;
      border-top: 1px solid var(--slate);
    }
    .consent h2 {
      margin: 0;
      flex-shrink: 0;
    }
    .consent p {
      margin: 0;
      flex: 1;
      font-size: 0.9rem;
    }
    .consent-row {
      flex-shrink: 0;
    }
    .consent-btn {
      padding: 0.7em 1.2em;
    }
  }
  /* Phones: text over the buttons. */
  @media (max-width: 719px) {
    .consent {
      flex-wrap: wrap;
    }
    .consent h2 {
      display: none;
    }
    .consent p {
      flex-basis: 100%;
      font-size: 0.86rem;
    }
  }
</style>
