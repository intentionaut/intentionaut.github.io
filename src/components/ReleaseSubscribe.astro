---
/**
 * The letter CTA for /open-source pages: the tools come from the build stories,
 * the build stories live in the letter. One line of pitch in the design
 * system's newsletter card, on the page's left edge.
 */
import FrameSubscribe from './FrameSubscribe.astro';

interface Props {
  /** utm_source, e.g. "open-source", "open-source-familiar". */
  source: string;
  /** Name the tool so the line reads specific, not boilerplate. */
  tool?: string;
}
const { source, tool } = Astro.props;
const line = tool
  ? `${tool} exists because of a newsletter. Intentionaut is where the build stories land first: what shipped, what went wrong, and what it cost.`
  : 'These tools come out of a newsletter. Intentionaut is where the build stories land first: what shipped, what went wrong, and what it cost.';
---

<section class="rel-subscribe" aria-label="Newsletter signup">
  <FrameSubscribe
    eyebrow="Newsletter"
    sub={line}
    source={source}
    emailId={`email-${source}`}
    buttonLabel="Get the letter"
    align="left"
  />
</section>

<style>
  /* One section gap above, like every other section (Layout). */
  .rel-subscribe {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
</style>
