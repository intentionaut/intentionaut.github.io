---
// "Who this is for": two short lists under a page's lede (#59).
// Items are trusted, hand-written HTML strings so a bullet can carry a link.
interface Props {
  fit: string[];
  notFit: string[];
}
const { fit, notFit } = Astro.props;
---

<div class="who-for">
  <div>
    <h2 class="who-for-title">Good fit</h2>
    <ul>{fit.map((t) => <li set:html={t} />)}</ul>
  </div>
  <div>
    <h2 class="who-for-title">Not the right fit</h2>
    <ul>{notFit.map((t) => <li set:html={t} />)}</ul>
  </div>
</div>

<style>
  .who-for {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
  }
  .who-for-title {
    font-size: var(--text-md);
    margin: 0 0 var(--space-2);
  }
  .who-for ul {
    margin: 0;
    padding-left: 1.1em;
    font-size: 0.95rem;
    line-height: 1.55;
    list-style-type: square;
  }
  .who-for li::marker {
    color: var(--accent-text);
  }
  .who-for li + li {
    margin-top: var(--space-2);
  }
  @media (max-width: 720px) {
    .who-for {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
