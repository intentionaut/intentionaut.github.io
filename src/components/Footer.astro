---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <!-- Three columns -->
    <div class="footer-cols">
      <div>
        <p class="eyebrow">Explore</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/projects/">Projects</a></li>
          <li><a href="/speaking/">Speaking</a></li>
          <li><a href="/writing/">Writing</a></li>
          <li><a href="/contact/">Work with me</a></li>
          <li><a href="/design-system/">Design system</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Connect</p>
        <ul>
          <li>
            <a href="https://www.linkedin.com/in/intentionaut" rel="me noopener" target="_blank">LinkedIn</a>
          </li>
          <li><a href="mailto:hello@intentionaut.com">Email</a></li>
          <li>
            <a href="https://newsletter.intentionaut.com/" rel="noopener" target="_blank">Newsletter</a>
          </li>
          <li><a href="/open-source/">Open source</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">The letter</p>
        <p class="footer-col-blurb">
          Fortnightly, every other Wednesday. Purpose, direction, action from a
          product leader fluent in design, data and AI.
        </p>
        <a class="link-arrow" href="/subscribe/"><span>Subscribe</span></a>
        <div class="footer-colophon">
          <p class="footer-name">Saielle DaSilva</p>
          <p class="footer-line">Putting the soft back in software.</p>
        </div>
      </div>
    </div>

    <p class="footer-legal">
      <span class="footer-legal-copy">© {year} Intentionaut Ltd · intentionaut.com</span>
      <span class="footer-legal-links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: none;
  }

  .site-footer .wrap {
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: stretch;
    padding-block-end: var(--space-8);
    text-transform: none;
    letter-spacing: normal;
  }

  .footer-cols .link-arrow {
    align-self: flex-start;
    margin-bottom: var(--space-6);
  }

  .footer-colophon {
    margin-top: auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--ink);
  }

  .footer-name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 560;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .footer-line {
    max-width: 46ch;
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 460;
    font-size: 1rem;
    color: var(--muted);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
    margin-top: var(--space-9);
  }

  .footer-cols > div {
    padding: var(--space-7);
    border-left: 1px solid var(--slate);
  }

  .footer-cols > div:first-child {
    border-left: none;
    padding-left: 0;
  }

  .footer-cols > div:last-child {
    display: flex;
    flex-direction: column;
    padding-right: 0;
  }

  .footer-cols .eyebrow {
    margin-bottom: var(--space-5);
  }

  .footer-cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .footer-cols ul a {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .footer-cols ul a:hover {
    color: var(--accent);
  }

  .footer-col-blurb {
    margin: 0 0 var(--space-5);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6) var(--space-7);
    margin: var(--space-7) 0 0;
    border-top: 1px solid var(--slate);
    padding-top: var(--space-5);
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-legal-copy {
    margin-right: auto;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .footer-legal a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .footer-cols {
      grid-template-columns: 1fr;
      margin-top: var(--space-7);
    }
    .footer-cols > div {
      border-left: none;
      border-top: 1px solid var(--slate);
      padding: var(--space-6) 0;
    }
    .footer-cols > div:first-child {
      border-top: none;
      padding-top: 0;
    }
    .footer-cols > div:last-child {
      display: contents;
    }
    .footer-colophon {
      order: -1;
      margin-top: 0;
      padding: 0 0 var(--space-6);
      border-top: none;
    }
    .footer-cols > div:last-child .eyebrow {
      border-top: 1px solid var(--slate);
      padding-top: var(--space-6);
    }
  }
</style>