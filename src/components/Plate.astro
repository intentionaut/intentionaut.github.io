---
/**
 * An icon in a small double-ruled frame, the site's "plate". Icons are
 * Phosphor duotone (MIT, src/assets/icons/LICENSE-phosphor.txt); the duotone
 * layer is filled pink or blue, and callers alternate the two.
 * Never use an icon made of the letters "AI".
 */
interface Props {
  /** A file name in src/assets/icons/, without .svg. The set is shown on /design-system/. */
  name: string;
  tone?: 'pink' | 'blue';
}
const { name, tone = 'pink' } = Astro.props;
const icons = import.meta.glob('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = icons[`../assets/icons/${name}.svg`] as string | undefined;
if (!raw) throw new Error(`Plate: no icon named "${name}"`);
// Icons with a clipPath use PLATEID so each plate on a page gets its own id.
const uid = `p${Math.random().toString(36).slice(2, 8)}`;
const svg = raw.replaceAll('opacity="0.2"', 'class="tone"').replaceAll('PLATEID', uid);
---

<span class:list={['plate', tone, `icon-${name}`]} aria-hidden="true" set:html={svg} />

<style>
  .plate {
    position: relative;
    width: 64px;
    height: 64px;
    border: 1px solid var(--ink);
    display: inline-grid;
    place-items: center;
    background: var(--card);
    flex: none;
  }
  .plate::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid var(--slate);
    pointer-events: none;
  }
  .plate :global(svg) {
    width: 32px;
    height: 32px;
    color: var(--ink);
  }
  /* A breeze: when the linked card or lane around a plate is hovered or
     focused, the icon sways gently like grass. Still for reduced motion. */
  :global(:is(a, .lane):hover) > .plate:not(.icon-compass, .icon-magnifying-glass, .icon-lighthouse, .icon-coffee, .icon-hammer, .icon-plant, .icon-microphone-ribbon, .icon-airplane-takeoff) :global(svg),
  :global(:is(a, .lane):focus-within) > .plate:not(.icon-compass, .icon-magnifying-glass, .icon-lighthouse, .icon-coffee, .icon-hammer, .icon-plant, .icon-microphone-ribbon, .icon-airplane-takeoff) :global(svg) {
    animation: plate-breeze 1.6s ease-in-out infinite;
    transform-origin: 50% 85%;
  }
  @keyframes plate-breeze {
    0%, 100% { transform: rotate(0); }
    30% { transform: rotate(6deg); }
    70% { transform: rotate(-4deg); }
  }
  /* Compass: the needle turns on its pivot to point north and holds while
     hovered; the dial stays still. The pivot is built into compass.svg (the
     needle is drawn around 0,0 in a group at the dial centre), so it turns on
     the spot in every browser. The settle is a spring (stiffness 170,
     damping 14) written as linear(). */
  .plate :global(.needle) {
    transform-origin: 0 0;
    transition: transform 0.5s cubic-bezier(0.3, 0, 0.2, 1);
  }
  .plate :global(.needle-fill) {
    fill: var(--card);
  }
  :global(:is(a, .lane):hover) > .plate :global(.needle),
  :global(:is(a, .lane):focus-within) > .plate :global(.needle) {
    transform: rotate(-45deg);
    transition: transform 0.9s linear(0.000, 0.039, 0.137, 0.272, 0.424, 0.578, 0.720, 0.845, 0.947, 1.026, 1.081, 1.116, 1.132, 1.135, 1.127, 1.112, 1.092, 1.072, 1.051, 1.032, 1.016, 1.004, 0.994, 0.987, 0.983, 0.982, 0.982, 0.983, 0.986, 0.988, 0.991, 0.994, 0.996, 0.998, 1.000, 1.001, 1.002, 1.002, 1.002, 1.002, 1.002);
  }
  /* Magnifying glass: the glass slides in from the left and settles over a
     plum £ that shows only inside the lens, as if found. The clip moves with
     the glass. Same spring as the compass; holds while hovered. */
  .plate :global(:is(.glass, .lens-clip)) {
    transition: transform 0.45s cubic-bezier(0.3, 0, 0.2, 1);
  }
  .plate :global(.cash) {
    font: 600 104px var(--font-body);
    fill: var(--ink);
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(:is(.glass, .lens-clip)) {
    animation: plate-sweep 1.1s linear(0.000, 0.039, 0.137, 0.272, 0.424, 0.578, 0.720, 0.845, 0.947, 1.026, 1.081, 1.116, 1.132, 1.135, 1.127, 1.112, 1.092, 1.072, 1.051, 1.032, 1.016, 1.004, 0.994, 0.987, 0.983, 0.982, 0.982, 0.983, 0.986, 0.988, 0.991, 0.994, 0.996, 0.998, 1.000, 1.001, 1.002, 1.002, 1.002, 1.002, 1.002) both;
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.cash) {
    opacity: 1;
    transition-delay: 0.15s;
  }
  @keyframes plate-sweep {
    from { transform: translateX(-56px); }
    to { transform: translateX(0); }
  }
  /* Lighthouse: one turn of the light per hover, then it fades. A single
     amber beam seen side-on, its length following cos(angle), so it reaches
     right, passes behind the tower and reaches left. The tower is filled
     solid (.tower-fill) so it hides the beam as it passes. */
  .plate.icon-lighthouse :global(svg),
  .plate.icon-microphone-ribbon :global(svg),
  .plate.icon-airplane-takeoff :global(svg) {
    overflow: visible;
  }
  .plate :global(.tower-fill) {
    fill: var(--card);
  }
  .plate :global(.beam) {
    transform-origin: 128px 84px;
    transform-box: view-box;
    opacity: 0;
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.beam) {
    opacity: 1;
    animation:
      plate-beam 3.6s linear both,
      plate-beam-out 0.4s ease-out 3.6s both;
  }
  @keyframes plate-beam {
    0%{transform:scaleX(1.000)}
    5%{transform:scaleX(0.951)}
    10%{transform:scaleX(0.809)}
    15%{transform:scaleX(0.588)}
    20%{transform:scaleX(0.309)}
    25%{transform:scaleX(0.000)}
    30%{transform:scaleX(-0.309)}
    35%{transform:scaleX(-0.588)}
    40%{transform:scaleX(-0.809)}
    45%{transform:scaleX(-0.951)}
    50%{transform:scaleX(-1.000)}
    55%{transform:scaleX(-0.951)}
    60%{transform:scaleX(-0.809)}
    65%{transform:scaleX(-0.588)}
    70%{transform:scaleX(-0.309)}
    75%{transform:scaleX(-0.000)}
    80%{transform:scaleX(0.309)}
    85%{transform:scaleX(0.588)}
    90%{transform:scaleX(0.809)}
    95%{transform:scaleX(0.951)}
    100%{transform:scaleX(1.000)}
  }
  @keyframes plate-beam-out {
    to { opacity: 0; }
  }
  /* Coffee: the cup stays as drawn; the three lines of steam draw up out of
     it one at a time with a small bounce. About 0.7s, once per hover. */
  .plate :global(.wisp) {
    transform-box: view-box;
  }
  .plate :global(.w0) { transform-origin: 88px 56px; }
  .plate :global(.w1) { transform-origin: 120px 56px; }
  .plate :global(.w2) { transform-origin: 152px 56px; }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.wisp) {
    animation: plate-steam 0.38s cubic-bezier(0.34, 1.45, 0.64, 1) both;
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.w1) {
    animation-delay: 0.16s;
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.w2) {
    animation-delay: 0.32s;
  }
  @keyframes plate-steam {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  /* Hammer: one strike, pivoting at the grip. Back 18 degrees slowly, down
     fast, stops dead at rest, a 3 degree recoil. 0.6s, once per hover. */
  .plate :global(.hammer) {
    transform-box: view-box;
    transform-origin: 50px 206px;
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.hammer) {
    animation: plate-strike 0.6s both;
  }
  @keyframes plate-strike {
    0% { transform: rotate(0); animation-timing-function: cubic-bezier(0.3, 0, 0.2, 1); }
    45% { transform: rotate(-18deg); animation-timing-function: cubic-bezier(0.6, 0, 1, 1); }
    68% { transform: rotate(0); animation-timing-function: ease-out; }
    80% { transform: rotate(-3deg); animation-timing-function: ease-in; }
    100% { transform: rotate(0); }
  }
  /* Plant: drawn in parts (stem, two leaves) so each leaf turns on the round
     end of its own branch with no gap. Each dips 10 degrees and springs open,
     right then left. About 0.7s, once per hover. */
  .plate :global(:is(.leaf-l, .leaf-r)) {
    transform-box: view-box;
  }
  .plate :global(.leaf-l) { transform-origin: 88.5px 160.5px; }
  .plate :global(.leaf-r) { transform-origin: 138.5px 149.5px; }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.leaf-r) {
    animation: plate-leaf-r 0.6s cubic-bezier(0.34, 1.3, 0.64, 1) both;
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.leaf-l) {
    animation: plate-leaf-l 0.6s cubic-bezier(0.34, 1.3, 0.64, 1) 0.12s both;
  }
  @keyframes plate-leaf-r {
    30% { transform: rotate(10deg); }
  }
  @keyframes plate-leaf-l {
    30% { transform: rotate(-10deg); }
  }
  /* Ribbon mic: raised to speaking height. Head and fork rise up the stand
     with a small settle while the stem stretches to meet them; the base stays
     put. 0.55s, holds while hovered. */
  .plate :global(:is(.mic-rig, .mic-stem)) {
    transform-box: view-box;
    transition: transform 0.35s cubic-bezier(0.3, 0, 0.2, 1);
  }
  .plate :global(.mic-stem) { transform-origin: 128px 224px; }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(:is(.mic-rig, .mic-stem)) {
    transition: transform 0.55s cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.mic-rig) {
    transform: translateY(-14px);
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.mic-stem) {
    transform: scaleY(1.5);
  }
  /* Plane: wheels up. The runway stays put; the plane pitches its nose up
     about its tail and climbs along its heading with a small spring. Holds
     while hovered, lands on leave. */
  .plate :global(.plane) {
    transform-box: view-box;
    transform-origin: 40px 150px;
    transition: transform 0.45s cubic-bezier(0.3, 0, 0.2, 1);
  }
  :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(.plane) {
    transform: translate(14px, -20px) rotate(-7deg);
    transition: transform 0.6s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(:is(a, .lane):hover) > .plate :global(svg),
    :global(:is(a, .lane):focus-within) > .plate :global(svg) {
      animation: none;
    }
    .plate :global(:is(.needle, .mic-rig, .mic-stem, .plane)) {
      transition: none;
    }
    :global(:is(a, .lane):is(:hover, :focus-within)) > .plate :global(:is(.glass, .lens-clip, .beam, .wisp, .hammer, .leaf-l, .leaf-r)) {
      animation: none;
    }
  }
  .plate.pink :global(.tone) {
    fill: var(--accent);
    opacity: 0.45;
  }
  .plate.blue :global(.tone) {
    fill: var(--teal);
    opacity: 0.9;
  }
</style>
