---
/**
 * FrameSubscribe       a design-system element for newsletter signups.
 *
 * The double-bordered card (an ink outline with a soft line drawn 3px inside
 * it) built around the newsletter signup form. It owns its heading, sub-line
 * and form, so every signup call on the site renders the same way.
 *
 * Usage:
 *   <FrameSubscribe
 *     eyebrow="Newsletter"
 *     heading="Intentionaut is a letter on design, product, data and AI. What is working, what isn't, and how to keep your bearings."
 *     source="home"
 *     emailId="home-email"
 *   />
 */
import SubscribeForm from './SubscribeForm.astro';
import { fetchPosts } from '../lib/beehiiv';

interface Props {
  /** Uppercase accent label above the heading. Optional. */
  eyebrow?: string;
  /** Prominent frame heading. Optional. */
  heading?: string;
  /** Supporting line under the heading. Optional. */
  sub?: string;
  /** utm_source context, passed through to the form. */
  source: string;
  /** utm_campaign, passed through: the essay's slug when the card closes one. */
  campaign?: string;
  /** Unique per instance, ties the input label to the field. */
  emailId: string;
  /** Button label. Default 'Subscribe'. */
  buttonLabel?: string;
  /** Max width of the card. Default 46rem. */
  maxWidth?: string;
  /** Horizontal alignment of the box and its content. Default 'center'; 'left' sits it on the page's left edge (design system Layout). */
  align?: 'center' | 'left';
}

const {
  eyebrow,
  heading,
  sub,
  source,
  campaign,
  emailId,
  buttonLabel = 'Subscribe',
  maxWidth = '46rem',
  align = 'center',
} = Astro.props;

// The latest letter, for the masthead line: shows the newsletter is alive.
const latest = eyebrow
  ? (await fetchPosts()).reduce<Awaited<ReturnType<typeof fetchPosts>>[number] | undefined>(
      (a, p) => (!a || p.publish_date > a.publish_date ? p : a),
      undefined
    )
  : undefined;
const latestLabel = latest
  ? new Date(latest.publish_date * 1000).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })
  : '';
---

<div
  class:list={['frame-subscribe', align === 'left' && 'frame-subscribe--left']}
  style={`max-width: ${maxWidth}; text-align: ${align}; margin-inline: ${align === 'left' ? '0' : 'auto'};`}
>
  {eyebrow && (
    <div class="fs-masthead">
      <p class="eyebrow">{eyebrow}</p>
      {latest && (
        <a class="fs-latest" href={`/writing/${latest.slug}/`}>Latest · {latestLabel}</a>
      )}
    </div>
  )}
  {heading && <h2 class="fs-heading">{heading}</h2>}
  {sub && <p class="fs-sub">{sub}</p>}
  <SubscribeForm source={source} campaign={campaign} emailId={emailId} buttonLabel={buttonLabel} />
</div>

<style>
  .frame-subscribe {
    position: relative;
    width: 100%;
    padding: var(--space-7) var(--space-8);
    border: 1px solid var(--ink);
  }

  .frame-subscribe::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid var(--slate);
    pointer-events: none;
  }

  /* Masthead: label left, the latest letter's date right, over a rule. */
  .fs-masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .fs-masthead .eyebrow {
    margin: 0;
  }
  .fs-latest {
    font: 500 0.7rem var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .fs-latest:hover,
  .fs-latest:focus-visible {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .fs-heading {
    margin: 0 0 var(--space-6);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 460;
    font-size: 1.15rem;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--ink);
  }

  .fs-sub {
    margin: 0 0 var(--space-6);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink);
  }

  /* Left-aligned box: the sign-up row starts on the same edge as the text. */
  .frame-subscribe--left :global(.signup-form) {
    margin-inline: 0;
    justify-content: flex-start;
  }

  /* A Card: everything written inside it is ink, the sign-up small print too. */
  .frame-subscribe :global(.subscribe-note),
  .frame-subscribe :global(.subscribe-status) {
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .frame-subscribe {
      padding: var(--space-6);
    }
  }
</style>
