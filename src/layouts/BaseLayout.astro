---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Adds <meta name="robots" content="noindex,follow">. */
  noindex?: boolean;
  /** 'article' switches og:type and lets published/modified times through. */
  ogType?: 'website' | 'article';
  /** Marks the WebPage node as a ProfilePage about Saielle. */
  profilePage?: boolean;
  /** ISO date strings for article og tags. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Extra schema.org node(s) merged into the page @graph (no @context). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Point the canonical somewhere else. For a page whose content now lives on
   * its own domain, so the two do not compete in search while both stay live.
   */
  canonicalUrl?: string;
}

const {
  title = 'Saielle DaSilva | Product leader across design, data & AI',
  description = 'Saielle DaSilva is a product leader fluent in design, product, data and AI, putting the soft back in software and turning deliberate direction into business impact.',
  noindex = false,
  ogType = 'website',
  profilePage = false,
  publishedTime,
  modifiedTime,
  jsonLd,
  canonicalUrl,
} = Astro.props;

const canonical = canonicalUrl
  ? new URL(canonicalUrl)
  : new URL(Astro.url.pathname, Astro.site);
const origin = Astro.site!.origin;
const canonicalStr = canonical.toString();

// Cloudflare Web Analytics: cookieless, GDPR-friendly, no banner required.
// Paste your beacon token from dash.cloudflare.com -> Web Analytics below.
// Nothing loads until this stops being the placeholder.
const CF_ANALYTICS_TOKEN = '41ba3048abea4294bc3977e2d8074ebb';
const showAnalytics =
  import.meta.env.PROD && !CF_ANALYTICS_TOKEN.startsWith('REPLACE');

// --- Structured data -------------------------------------------------------
// One @graph per page: a stable Person / Organization / WebSite identity plus
// a per-page WebPage node, then whatever the page passes in via `jsonLd`.
const person = {
  '@type': 'Person',
  '@id': `${origin}/#person`,
  name: 'Saielle DaSilva',
  url: `${origin}/`,
  image: {
    '@type': 'ImageObject',
    url: `${origin}/saielle-dasilva.jpg`,
    width: 360,
    height: 480,
  },
  jobTitle: 'Fractional & Interim Product Leader',
  description:
    'Product leader fluent in design, product, data and AI. Founders and product leaders bring her in when direction is the bottleneck.',
  worksFor: { '@id': `${origin}/#organization` },
  alumniOf: ["Sainsbury's", 'StepStone', 'Cazoo', 'Pivotal', 'Amazon', 'AT&T'].map(
    (name) => ({ '@type': 'Organization', name })
  ),
  knowsAbout: [
    'Product management',
    'Product strategy',
    'Product leadership',
    'AI product strategy',
    'Data platforms',
    'Design leadership',
    'Product operating models',
    'Product-led transformation',
  ],
  sameAs: [
    'https://www.linkedin.com/in/intentionaut',
    'https://turingfest.com/speaker/saielle-dasilva/',
    'https://businessofsoftware.org/talks/speakers/saielle-dasilva/',
    'https://www.oneknightinproduct.com/saielle-dasilva/',
    'https://newsletter.intentionaut.com/',
  ],
};

const organization = {
  '@type': 'Organization',
  '@id': `${origin}/#organization`,
  name: 'Intentionaut Ltd',
  url: `${origin}/`,
  logo: `${origin}/favicon.svg`,
  founder: { '@id': `${origin}/#person` },
  sameAs: ['https://www.linkedin.com/in/intentionaut'],
};

const website = {
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  url: `${origin}/`,
  name: 'Saielle DaSilva',
  publisher: { '@id': `${origin}/#organization` },
  inLanguage: 'en',
};

const isHome = canonical.pathname === '/';
const webPage = {
  '@type': profilePage ? ['WebPage', 'ProfilePage'] : 'WebPage',
  '@id': `${canonicalStr}#webpage`,
  url: canonicalStr,
  name: title,
  description,
  isPartOf: { '@id': `${origin}/#website` },
  inLanguage: 'en',
  ...(profilePage || isHome
    ? { [profilePage ? 'mainEntity' : 'about']: { '@id': `${origin}/#person` } }
    : {}),
};

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [person, organization, website, webPage, ...extra],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:site_name" content="Saielle DaSilva" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && (
      <meta
        property="article:modified_time"
        content={modifiedTime ?? publishedTime}
      />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content="Saielle DaSilva" />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(graph)}
    />
    {/*
      First-touch campaign capture.

      The subscribe form only ever saw the query string of the page it sat on,
      and 22 pages carry no form at all (/keynote-speaker/, /fractional/,
      /forward-deployed/, /about/ among them). So a reader arriving from a
      newsletter or a post, browsing, and subscribing a page or two later was
      recorded as having come from whatever page the form happened to be on.
      That is the arrival this whole funnel exists to measure.

      So the tags are stored on arrival, on every page, and the form falls back
      to them. First touch wins: a reader who lands from LinkedIn and wanders
      the site is still a LinkedIn arrival, and later internal navigation must
      not overwrite the campaign that actually earned them.

      sessionStorage, not localStorage, so it expires with the visit rather
      than crediting a campaign months later. Inline and in the head so it runs
      before any navigation. Wrapped, because storage throws outright in some
      privacy modes and an analytics nicety must never break a page.
    */}
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem('firstTouch')) return;
          var p = new URLSearchParams(location.search);
          var t = {
            source: p.get('utm_source') || p.get('ref') || '',
            medium: p.get('utm_medium') || '',
            campaign: p.get('utm_campaign') || '',
          };
          if (t.source || t.medium || t.campaign) {
            sessionStorage.setItem('firstTouch', JSON.stringify(t));
          }
        } catch (e) {
          /* private mode, or storage disabled. Attribution is optional. */
        }
      })();
    </script>
    <slot name="head" />
    {
      showAnalytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
